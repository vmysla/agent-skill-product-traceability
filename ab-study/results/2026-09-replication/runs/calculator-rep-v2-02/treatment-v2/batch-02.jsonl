9f00; }\n  button.op.active { background: #fff; color: #f59f00; }\n  button.clear { background: #868e96; }\n  button.wide { grid-column: span 2; }\n</style>\n</head>\n<body>\n<div class=\"calc\">\n  <div class=\"display\" data-testid=\"calc-display\" data-value=\"0\">0</div>\n  <div class=\"keys\">\n    <button class=\"clear wide\" data-testid=\"key-clear\">AC</button>\n    <button class=\"op\" data-testid=\"key-div\" data-op=\"/\">÷</button>\n    <button class=\"op\" data-testid=\"key-mul\" data-op=\"*\">×</button>\n\n    <button data-testid=\"key-7\">7</button>\n    <button data-testid=\"key-8\">8</button>\n    <button data-testid=\"key-9\">9</button>\n    <button class=\"op\" data-testid=\"key-sub\" data-op=\"-\">−</button>\n\n    <button data-testid=\"key-4\">4</button>\n    <button data-testid=\"key-5\">5</button>\n    <button data-testid=\"key-6\">6</button>\n    <button class=\"op\" data-testid=\"key-add\" data-op=\"+\">+</button>\n\n    <button data-testid=\"key-1\">1</button>\n    <button data-testid=\"key-2\">2</button>\n    <button data-testid=\"key-3\">3</button>\n    <button class=\"op\" data-testid=\"key-equals\">=</button>\n\n    <button class=\"wide\" data-testid=\"key-0\">0</button>\n    <button data-testid=\"key-dot\">.</button>\n  </div>\n</div>\n<script>\n  var display = document.querySelector('[data-testid=\"calc-display\"]');\n\n  var state = {\n    entry: '0',       // text of the number being shown/typed\n    stored: null,     // left operand\n    op: null,         // pending operator\n    fresh: true,      // next digit starts a new entry\n    error: false\n  };\n\n  // [REQ-001]\n  function compute(a, op, b) {\n    switch (op) {\n      case '+': return a + b;\n      case '-': return a - b;\n      case '*': return a * b;\n      case '/': return a / b;\n    }\n    return b;\n  }\n\n  // [REQ-001]\n  function render() {\n    display.textContent = state.error ? 'Error' : state.entry;\n    display.setAttribute('data-value', state.error ? 'NaN' : String(Number(state.entry)));\n    document.querySelectorAll('button[data-op]').forEach(function (b) {\n      b.classList.toggle('active', state.fresh && state.op === b.getAttribute('data-op'));\n    });\n  }\n\n  // [REQ-001]\n  function setResult(value) {\n    if (!isFinite(value)) {\n      state.error = true;\n      state.entry = '0';\n      state.stored = null;\n      state.op = null;\n    } else {\n      state.entry = String(value);\n    }\n    state.fresh = true;\n  }\n\n  // [REQ-001]\n  function inputDigit(d) {\n    if (state.error) clearAll();\n    if (state.fresh) {\n      state.entry = d;\n      state.fresh = false;\n    } else {\n      state.entry = state.entry === '0' ? d : state.entry + d;\n    }\n  }\n\n  // [REQ-001]\n  function inputDot() {\n    if (state.error) clearAll();\n    if (state.fresh) {\n      state.entry = '0.';\n      state.fresh = false;\n    } else if (state.entry.indexOf('.') === -1) {\n      state.entry += '.';\n    }\n  }\n\n  // [REQ-001]\n  function inputOperator(op) {\n    if (state.error) return;\n    if (state.op !== null && !state.fresh) {\n      setResult(compute(state.stored, state.op, Number(state.entry)));\n      if (state.error) return;\n    }\n    state.stored = Number(state.entry);\n    state.op = op;\n    state.fresh = true;\n  }\n\n  // [REQ-001]\n  function equals() {\n    if (state.error || state.op === null) return;\n    var result = compute(state.stored, state.op, Number(state.entry));\n    state.stored = null;\n    state.op = null;\n    setResult(result);\n  }\n\n  // [REQ-001]\n  function clearAll() {\n    state.entry = '0';\n    state.stored = null;\n    state.op = null;\n    state.fresh = true;\n    state.error = false;\n  }\n\n  document.querySelector('.keys').addEventListener('click', function (e) {\n    var btn = e.target.closest('button');\n    if (!btn) return;\n    var id = btn.getAttribute('data-testid');\n    if (/^key-\\d$/.test(id)) inputDigit(id.slice(4));\n    else if (id === 'key-dot') inputDot(