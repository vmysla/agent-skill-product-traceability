"0\" role=\"status\" aria-live=\"polite\">0</div>\n  <div class=\"keys\">\n    <button class=\"fn wide\" data-testid=\"key-clear\" data-key=\"clear\">AC</button>\n    <button class=\"op\" data-testid=\"key-div\" data-key=\"div\" aria-label=\"divide\">÷</button>\n    <button class=\"op\" data-testid=\"key-mul\" data-key=\"mul\" aria-label=\"multiply\">×</button>\n    <button data-testid=\"key-7\" data-key=\"7\">7</button>\n    <button data-testid=\"key-8\" data-key=\"8\">8</button>\n    <button data-testid=\"key-9\" data-key=\"9\">9</button>\n    <button class=\"op\" data-testid=\"key-sub\" data-key=\"sub\" aria-label=\"subtract\">−</button>\n    <button data-testid=\"key-4\" data-key=\"4\">4</button>\n    <button data-testid=\"key-5\" data-key=\"5\">5</button>\n    <button data-testid=\"key-6\" data-key=\"6\">6</button>\n    <button class=\"op\" data-testid=\"key-add\" data-key=\"add\" aria-label=\"add\">+</button>\n    <button data-testid=\"key-1\" data-key=\"1\">1</button>\n    <button data-testid=\"key-2\" data-key=\"2\">2</button>\n    <button data-testid=\"key-3\" data-key=\"3\">3</button>\n    <button class=\"op\" data-testid=\"key-equals\" data-key=\"equals\" aria-label=\"equals\">=</button>\n    <button class=\"wide\" data-testid=\"key-0\" data-key=\"0\">0</button>\n    <button data-testid=\"key-dot\" data-key=\"dot\" aria-label=\"decimal point\">.</button>\n  </div>\n</main>\n<script>\n// Pure calculator logic. State: acc (stored left operand), op (pending operator),\n// entry (digits being typed, or null), value (the current number).\nvar OPS = {\n  add: function (a, b) { return a + b; },\n  sub: function (a, b) { return a - b; },\n  mul: function (a, b) { return a * b; },\n  div: function (a, b) { return a / b; }\n};\n\nfunction initialState() {\n  return { acc: null, op: null, entry: null, value: 0 };\n}\n\nfunction press(s, key) {\n  if (key === 'clear') return initialState();\n\n  // After an error, any key except an operator starts over.\n  if (!isFinite(s.value) && s.entry === null) {\n    if (key in OPS || key === 'equals') return s;\n    s = initialState();\n  }\n\n  if (/^[0-9]$/.test(key)) {\n    var entry = s.entry === null || s.entry === '0' ? key : s.entry + key;\n    return { acc: s.acc, op: s.op, entry: entry, value: Number(entry) };\n  }\n\n  if (key === 'dot') {\n    var e = s.entry === null ? '0' : s.entry;\n    if (e.indexOf('.') !== -1) return s;\n    e += '.';\n    return { acc: s.acc, op: s.op, entry: e, value: Number(e) };\n  }\n\n  if (key in OPS) {\n    // Operator right after another operator replaces it.\n    if (s.op && s.entry === null) return { acc: s.acc, op: key, entry: null, value: s.value };\n    var v = s.op ? OPS[s.op](s.acc, s.value) : s.value;\n    return { acc: v, op: key, entry: null, value: v };\n  }\n\n  if (key === 'equals') {\n    if (!s.op) return { acc: null, op: null, entry: null, value: s.value };\n    var r = OPS[s.op](s.acc, s.value);\n    return { acc: null, op: null, entry: null, value: r };\n  }\n\n  return s;\n}\n\n// Visible text: the entry as typed, or the value rounded to hide float noise.\nfunction displayText(s) {\n  if (s.entry !== null) return s.entry;\n  if (!isFinite(s.value)) return 'Error';\n  return String(parseFloat(s.value.toPrecision(12)));\n}\n\nif (typeof document !== 'undefined') {\n  var state = initialState();\n  var display = document.querySelector('[data-testid=\"calc-display\"]');\n  var opButtons = document.querySelectorAll('[data-key=\"add\"],[data-key=\"sub\"],[data-key=\"mul\"],[data-key=\"div\"]');\n\n  function render() {\n    display.textContent = displayText(state);\n    display.setAttribute('data-value', String(state.value));\n    for (var i = 0; i < opButtons.length; i++) {\n      var b = opButtons[i];\n      b.classList.toggle('active', state.op === b.dataset.key && state.entry === null);\n    }\n  }\n\n  document.querySelector('.keys').addEventListener('click', function (ev) {\n    var btn = ev.target.closest('button');\n    if (!btn) return;\n    state = press(state, btn.dataset.key);\n    render();\n  });\n\n  var KEYMAP = { '.': 'dot', ',': 'dot', '+': 'add', '-': 'sub', '*': 'mul', 'x': 'mul', '/': 'div',\n    '=': 'equals', 'Enter': 'equals', 'Escape': 'clear', 'c': 'clear', 'C': 'clear' };\n  document.addEventListener('keydown', function (ev) {\n    var key = /^[0-9]$/.test(ev.key) ? ev.key : KEYMAP[ev.key];\n    if (!key || ev.ctrlKey || ev.metaKey || ev.altKey) return;\n    ev.preventDefault();\n    state = press(state, key);\n    render();\n  });\n\n  render();\n}\n</script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":9335,"cache_read_input_tokens":26922,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":9335},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c104722c-a23b-4e4a-b757-ad1f07f175c4","uuid":"3d417b9d-7f28-4439-a510-7aa3d36ace16","timestamp":"2026-09-13T02:00:01.854Z","request_id":"req_011CezcRoY4oLUmdojoNLbGj"}
