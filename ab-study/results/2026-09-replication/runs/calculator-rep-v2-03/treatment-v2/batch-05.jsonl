+ fracPart : '');\n  }\n\n  // [REQ-003] enter the error state\n  function setError() {\n    state.error = true;\n    render();\n  }\n\n  // [REQ-001] digits build the entry\n  // [REQ-004] a shown result (not typed) is replaced, not appended to\n  function inputDigit(d) {\n    if (state.fresh || !state.typing) {\n      state.entry = d;\n      state.fresh = false;\n    } else {\n      state.entry = state.entry === '0' ? d : state.entry + d;\n    }\n    state.typing = true;\n    render();\n  }\n\n  // [REQ-001] at most one decimal point per entry\n  function inputDot() {\n    if (state.fresh || !state.typing) {\n      state.entry = '0.';\n      state.fresh = false;\n    } else if (state.entry.indexOf('.') === -1) {\n      state.entry += '.';\n    }\n    state.typing = true;\n    render();\n  }\n\n  // [REQ-004] flip the sign of the current entry; a typed entry keeps its text\n  function inputSign() {\n    if (state.typing) {\n      if (state.entry !== '0') {\n        state.entry = state.entry.charAt(0) === '-' ? state.entry.slice(1) : '-' + state.entry;\n      }\n    } else {\n      state.entry = String(-Number(state.entry) || 0);\n      state.fresh = false;\n    }\n    render();\n  }\n\n  // [REQ-004] divide the current entry by 100; the result is shown formatted\n  function inputPercent() {\n    state.entry = String(Number(state.entry) / 100);\n    state.fresh = false;\n    state.typing = false;\n    render();\n  }\n\n  // [REQ-001] store the operator; chains evaluate left to right\n  // [REQ-002] immediate execution: an operator first applies the waiting op and shows the\n  // running result; no precedence, so 2 + 3 × 4 = is 20\n  function inputOp(op) {\n    var current = Number(state.entry);\n    if (state.op !== null && !state.fresh) {\n      var result = compute(state.stored, state.op, current);\n      if (result === null) return setError();\n      state.entry = String(result);\n      state.stored = result;\n    } else if (state.op === null) {\n      state.stor