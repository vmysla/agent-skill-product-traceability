\"calc-display\" data-value=\"0\" data-error=\"false\">0</div>\n  <div class=\"keys\">\n    <button class=\"clear wide\" data-testid=\"key-clear\">AC</button>\n    <button class=\"op\" data-testid=\"key-div\" data-op=\"/\">÷</button>\n    <button class=\"op\" data-testid=\"key-mul\" data-op=\"*\">×</button>\n    <button data-testid=\"key-7\" data-digit=\"7\">7</button>\n    <button data-testid=\"key-8\" data-digit=\"8\">8</button>\n    <button data-testid=\"key-9\" data-digit=\"9\">9</button>\n    <button class=\"op\" data-testid=\"key-sub\" data-op=\"-\">−</button>\n    <button data-testid=\"key-4\" data-digit=\"4\">4</button>\n    <button data-testid=\"key-5\" data-digit=\"5\">5</button>\n    <button data-testid=\"key-6\" data-digit=\"6\">6</button>\n    <button class=\"op\" data-testid=\"key-add\" data-op=\"+\">+</button>\n    <button data-testid=\"key-1\" data-digit=\"1\">1</button>\n    <button data-testid=\"key-2\" data-digit=\"2\">2</button>\n    <button data-testid=\"key-3\" data-digit=\"3\">3</button>\n    <button class=\"op\" data-testid=\"key-equals\">=</button>\n    <button class=\"wide\" data-testid=\"key-0\" data-digit=\"0\">0</button>\n    <button data-testid=\"key-dot\">.</button>\n  </div>\n</div>\n<script>\n  var displayEl = document.querySelector('[data-testid=\"calc-display\"]');\n\n  var state;\n\n  // [REQ-001] reset to the initial state: display 0, nothing pending\n  // [REQ-003] clear also leaves the error state\n  function clearAll() {\n    state = { entry: '0', stored: null, op: null, fresh: true, typing: false, error: false };\n    render();\n  }\n\n  // [REQ-001] apply an operator\n  // [REQ-003] exact result, never rounded; division by zero returns null (error)\n  function compute(a, op, b) {\n    if (op === '+') return a + b;\n    if (op === '-') return a - b;\n    if (op === '*') return a * b;\n    if (b === 0) return null;\n    return a / b;\n  }\n\n  // [REQ-003] presentation only: at most 10 significant digits, no trailing zeros,\n  // exponential only when |n| >= 1e10 or |n| < 1e-9\n  function formatNumber(n) {\n    if (n === 0) return '0';\n    if (!isFinite(n)) return String(n);\n    var parts = n.toExponential(9).split('e');\n    var exp = Number(parts[1]);\n    if (exp >= 10 || exp < -9) {\n      return parts[0].replace(/\\.?0+$/, '') + 'e' + (exp >= 0 ? '+' : '') + exp;\n    }\n    var sign = n < 0 ? '-' : '';\n    var digits = parts[0].replace('-', '').replace('.', '');\n    var intPart, fracPart;\n    if (exp >= 0) {\n      intPart = digits.slice(0, exp + 1);\n      fracPart = digits.slice(exp + 1);\n    } else {\n      intPart = '0';\n      fracPart = new Array(-exp).join('0') + digits;\n    }\n    fracPart = fracPart.replace(/0+$/, '');\n    return sign + intPart + (fracPart ? '.' + fracPart : '');\n  }\n\n  // [REQ-003] enter the error state\n  function setError() {\n    state.error = true;\n    render();\n  }\n\n  // [REQ-001] digits build the entry\n  function inputDigit(d) {\n    if (state.fresh) {\n      state.entry = d;\n      state.fresh = false;\n    } else {\n      state.entry = state.entry === '0' ? d : state.entry + d;\n    }\n    state.typing = true;\n    render();\n  }\n\n  // [REQ-001] at most one decimal point per entry\n  function inputDot() {\n    if (state.fresh) {\n      state.entry = '0.';\n      state.fresh = false;\n    } else if (state.entry.indexOf('.') === -1) {\n      state.entry += '.';\n    }\n    state.typing = true;\n    render();\n  }\n\n  // [REQ-001] store the operator; chains evaluate left to right\n  // [REQ-002] immediate execution: an operator first applies the waiting op and shows the\n  // running result; no precedence, so 2 + 3 × 4 = is 20\n  function inputOp(op) {\n    var current = Number(state.entry);\n    if (state.op !== null && !state.fresh) {\n      var result = compute(state.stored, state.op, current);\n      if (result === null) return setError();\n      state.entry = String(result);\n      state.stored = result;\n    } else if (state.op === null) {\n      state.stored = current;\n    }\n    state.op = op;\n    state.fresh = true;\n    state.typing = false;\n    render();\n  }\n\n  // [REQ-001] equals shows the result of stored op entry\n  function equals() {\n    if (state.op === null) return;\n    var result = compute(state.stored, state.op, Number(state.entry));\n    if (result === null) return setError();\n    state.entry = String(result);\n    state.stored = null;\n    state.op = null;\n    state.fresh = true;\n    state.typing = false;\n    render();\n  }\n\n  // [REQ-001] data-value holds String(value)\n  // [REQ-003] typed entry shown as typed; other numbers formatted at render time only;\n  // data-value stays exact; data-error always present\n  function render() {\n    var value = Number(state.entry);\n    if (state.error) {\n      displayEl.textContent = 'Error';\n      displayEl.setAttribute('data-value', 'NaN');\n    } else {\n      displayEl.textContent = state.typing ? state.entry : formatNumber(value);\n      displayEl.setAttribute('data-value', String(value));\n    }\n    displayEl.setAttribute('data-error', state.error ? 'true' : 'false');\n  }\n\n  document.querySelector('.keys').addEventListener('click', function (e) {\n    var btn = e.target.closest('button');\n    if (!btn) return;\n    var id = btn.getAttribute('data-testid');\n    // [REQ-003] in the error state only clear works\n    if (state.error && id !== 'key-clear') return;\n    if (btn.hasAttribute('data-digit')) inputDigit(btn.getAttribute('data-digit'));\n    else if (btn.hasAttribute('data-op')) inputOp(btn.getAttribute('data-op'));\n    else if (id === 'key-dot') inputDot();\n    else if (id === 'key-equals') equals();\n    else if (id === 'key-clear') clearAll();\n  });\n\n  clearAll();\n</script>\n</body>\n</html>\n","numLines":219,"startLine":1,"totalLines":219}}}
