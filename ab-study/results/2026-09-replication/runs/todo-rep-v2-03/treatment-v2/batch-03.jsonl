nd: #c53030; padding: 6px 10px; font-size: 0.9rem; }\n  li input[type=\"checkbox\"] { flex: none; width: 18px; height: 18px; margin: 0; }\n  li[data-completed=\"true\"] span { text-decoration: line-through; color: #888; }\n  .filters { display: flex; gap: 8px; margin-bottom: 16px; }\n  .filters button { background: #e2e8f0; color: #222; padding: 6px 12px; font-size: 0.9rem; }\n  .filters button[aria-pressed=\"true\"] { background: #2b6cb0; color: #fff; }\n</style>\n</head>\n<body>\n<main>\n  <h1>Todos</h1>\n  <form id=\"todo-form\">\n    <input data-testid=\"todo-input\" type=\"text\" placeholder=\"What needs doing?\" autocomplete=\"off\" aria-label=\"New todo\">\n    <button data-testid=\"todo-add\" type=\"submit\">Add</button>\n  </form>\n  <div class=\"filters\">\n    <button data-testid=\"filter-all\" data-filter=\"all\" type=\"button\" aria-pressed=\"true\">All</button>\n    <button data-testid=\"filter-active\" data-filter=\"active\" type=\"button\" aria-pressed=\"false\">Active</button>\n    <button data-testid=\"filter-completed\" data-filter=\"completed\" type=\"button\" aria-pressed=\"false\">Completed</button>\n  </div>\n  <ul data-testid=\"todo-list\"></ul>\n</main>\n<script>\n  var STORAGE_KEY = 'todos';\n  var form = document.getElementById('todo-form');\n  var input = document.querySelector('[data-testid=\"todo-input\"]');\n  var list = document.querySelector('[data-testid=\"todo-list\"]');\n  var filterButtons = document.querySelectorAll('[data-filter]');\n  var todos = loadTodos();\n  var currentFilter = 'all';\n\n  // [REQ-001]\n  function loadTodos() {\n    try {\n      var data = JSON.parse(localStorage.getItem(STORAGE_KEY));\n      return Array.isArray(data) ? data : [];\n    } catch (e) {\n      return [];\n    }\n  }\n\n  // [REQ-001]\n  function saveTodos() {\n    try {\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));\n    } catch (e) {}\n  }\n\n  // [REQ-001]\n  function makeId() {\n    if (window.crypto && typeof crypto.randomUUID === 'function') return crypto.randomUUID();\n    return Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);\n  }\n\n  // [REQ-001]\n  function addTodo(text) {\n    text = text.trim();\n    if (!text) return;\n    todos.push({ id: makeId(), text: text, createdAt: Date.now(), completed: false });\n    saveTodos();\n    render();\n  }\n\n  // [REQ-001]\n  function deleteTodo(id) {\n    todos = todos.filter(function (t) { return t.id !== id; });\n    saveTodos();\n    render();\n  }\n\n  // [REQ-002]\n  function toggleTodo(id) {\n    todos.forEach(function (t) {\n      if (t.id === id) t.completed = !t.completed;\n    });\n    saveTodos();\n    render();\n  }\n\n  // [REQ-002] Active todos first, then completed; insertion order within each group.\n  function visibleTodos(items, filter) {\n    var active = items.filter(function (t) { return !t.completed; });\n    var done = items.filter(function (t) { return !!t.completed; });\n    if (filter === 'active') return active;\n    if (filter === 'completed') return done;\n    return active.concat(done);\n  }\n\n  // [REQ-002]\n  function setFilter(filter) {\n    currentFilter = filter;\n    render();\n  }\n\n  // [REQ-001] [REQ-002]\n  function render() {\n    list.textContent = '';\n    filterButtons.forEach(function (btn) {\n      btn.setAttribute('aria-pressed', String(btn.dataset.filter === currentFilter));\n    });\n    visibleTodos(todos, currentFilter).forEach(function (todo) {\n      var li = document.createElement('li');\n      li.setAttribute('data-testid', 'todo-item');\n      li.setAttribute('data-completed', String(!!todo.completed));\n      li.dataset.id = todo.id;\n\n      var toggle = document.createElement('input');\n      toggle.type = 'checkbox';\n      toggle.setAttribute('data-testid', 'todo-toggle');\n      toggle.setAttribute('aria-label', 'Mark complete');\n      toggle.checked = !!todo.completed;\n      toggle.addEventListener('change', function () { toggleTodo(todo.id); });\n\n      var span = document.createElement('span');\n      span.setAttribute('data-testid', 'todo-text');\n      span.textContent = todo.text;\n\n      var del = document.createElement('button');\n      del.type = 'button';\n      del.setAttribute('data-testid', 'todo-delete');\n      del.textContent = 'Delete';\n      del.addEventListener('click', function () { deleteTodo(todo.id); });\n\n      li.appendChild(toggle);\n      li.appendChild(span);\n      li.appendChild(del);\n      list.appendChild(li);\n    });\n  }\n\n  filterButtons.forEach(function (btn) {\n    btn.addEventListener('click', function () { setFilter(btn.dataset.filter); });\n  });\n\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    addTodo(input.value);\n    input.value = '';\n    input.focus();\n  });\n\n  render();\n</script>\n</body>\n</html>\n","numLines":163,"startLine":1,"totalLines":163}}}
