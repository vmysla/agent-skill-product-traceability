size: 24px; }\n  form { display: flex; flex-wrap: wrap; gap: 8px; }\n  input[type=\"text\"], input[type=\"date\"], select {\n    min-width: 0;\n    padding: 10px 12px;\n    font: inherit;\n    color: inherit;\n    background: #fff;\n    border: 1px solid #d2d2d7;\n    border-radius: 8px;\n  }\n  input[type=\"text\"] { flex: 1 1 180px; }\n  input[type=\"date\"], select { flex: 0 1 auto; }\n  input[type=\"text\"]:focus, input[type=\"date\"]:focus, select:focus { outline: 2px solid #0071e3; outline-offset: -1px; border-color: transparent; }\n  button {\n    font: inherit;\n    border: 0;\n    border-radius: 8px;\n    cursor: pointer;\n  }\n  .add { padding: 10px 16px; background: #0071e3; color: #fff; }\n  .add:hover { background: #0077ed; }\n  ul { list-style: none; margin: 16px 0 0; padding: 0; }\n  li {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-top: 6px;\n    padding: 10px 8px 10px 12px;\n    border-radius: 8px;\n    background: #f2f2f4;\n  }\n  li:first-child { margin-top: 0; }\n  /* Priority colours: high red, med amber, low grey. */\n  li[data-priority=\"high\"] { background: #fdecec; }\n  li[data-priority=\"med\"] { background: #fff4de; }\n  li[data-priority=\"low\"] { background: #f2f2f4; }\n  .priority { flex: none; padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; }\n  li[data-priority=\"high\"] .priority { background: #f9d0d3; color: #b0000f; }\n  li[data-priority=\"med\"] .priority { background: #fde2ad; color: #8a5300; }\n  li[data-priority=\"low\"] .priority { background: #e3e3e8; color: #5e5e63; }\n  .content { flex: 1; min-width: 0; }\n  .text { display: block; overflow-wrap: anywhere; }\n  .due { display: block; margin-top: 2px; font-size: 13px; color: #86868b; }\n  .due[hidden] { display: none; }\n  li[data-overdue=\"true\"] { box-shadow: inset 3px 0 0 #d70015; }\n  li[data-overdue=\"true\"] .due { color: #d70015; font-weight: 600; }\n  li[data-overdue=\"true\"][data-completed=\"true\"] { box-shadow: inset 3px 0 0 #f2b8bd; }\n  li[data-overdue=\"true\"][data-completed=\"true\"] .due { color: #86868b; font-weight: 400; }\n  .delete { padding: 6px 10px; background: transparent; color: #86868b; }\n  .delete:hover { background: rgba(215, 0, 21, 0.1); color: #d70015; }\n  .empty { margin: 16px 0 0; color: #86868b; text-align: center; }\n  .toggle { width: 18px; height: 18px; margin: 0; flex: none; cursor: pointer; accent-color: #0071e3; }\n  li[data-completed=\"true\"] .text { color: #86868b; text-decoration: line-through; }\n  .filters { display: flex; gap: 4px; margin: 16px 0 0; }\n  .filter { padding: 6px 12px; background: transparent; color: #1d1d1f; font-size: 14px; }\n  .filter:hover { background: #f5f5f7; }\n  .filter[aria-pressed=\"true\"] { background: #e8f1fc; color: #0071e3; }\n</style>\n</head>\n<body>\n<main>\n  <h1>Todos</h1>\n  <form id=\"todo-form\" autocomplete=\"off\">\n    <input type=\"text\" data-testid=\"todo-input\" id=\"todo-input\" placeholder=\"What needs doing?\" aria-label=\"New todo\">\n    <input type=\"date\" data-testid=\"todo-due\" id=\"todo-due\" aria-label=\"Due date (optional)\">\n    <select data-testid=\"todo-priority\" id=\"todo-priority\" aria-label=\"Priority\">\n      <option value=\"low\">Low</option>\n      <option value=\"med\" selected>Med</option>\n      <option value=\"high\">High</option>\n    </select>\n    <button type=\"submit\" class=\"add\" data-testid=\"todo-add\">Add</button>\n  </form>\n  <div class=\"filters\" role=\"group\" aria-label=\"Show\">\n    <button type=\"button\" class=\"filter\" data-testid=\"filter-all\" data-filter=\"all\" aria-pressed=\"true\">All</button>\n    <button type=\"button\" class=\"filter\" data-testid=\"filter-active\" data-filter=\"active\" aria-pressed=\"false\">Active</button>\n    <button type=\"button\" class=\"filter\" data-testid=\"filter-completed\" data-filter=\"completed\" aria-pressed=\"false\">Completed</button>\n  </div>\n  <ul data-testid=\"todo-list\" id=\"todo-list\"></ul>\n  <p class=\"empty\" id=\"empty\">Nothing here yet.</p>\n</main>\n<script>\n(function () {\n  var STORAGE_KEY = 'todos';\n\n  var form = document.getElementById('todo-form');\n  var input = document.getElementById('todo-input');\n  var dueInput = document.getElementById('todo-due');\n  var priorityInput = document.getElementById('todo-priority');\n  var list = document.getElementById('todo-list');\n  var empty = document.getElementById('empty');\n  var filterButtons = document.querySelectorAll('[data-filter]');\n\n  var filter = 'all';\n\n  function load() {\n    try {\n      var data = JSON.parse(localStorage.getItem(STORAGE_KEY));\n      return Array.isArray(data) ? data : [];\n    } catch (e) {\n      return [];\n    }\n  }\n\n  function save() {\n    try {\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(todos));\n    } catch (e) {\n      // Storage unavailable or full; keep working in memory.\n    }\n  }\n\n  function newId() {\n    if (window.crypto && typeof crypto.randomUUID === 'function') {\n      return crypto.randomUUID();\n    }\n    return Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);\n  }\n\n  var todos = load();\n\n  // Date rule (project decision): a due date is stored as a plain \"YYYY-MM-DD\"\n  // string and means a LOCAL calendar date. Never pass it through Date parsing\n  // or UTC (new Date(\"YYYY-MM-DD\") is UTC midnight and shifts the day).\n  // Overdue = due date strictly before today's local date; date-only, so a\n  // todo due today is never overdue. Zero-padded strings compare correctly as text.\n  var DATE_RE = /^\\d{4}-\\d{2}-\\d{2}$/;\n\n  function pad(n) {\n    return (n < 10 ? '0' : '') + n;\n  }\n\n  function todayLocal() {\n    var now = new Date();\n    return now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());\n  }\n\n  function validDue(value) {\n    return typeof value === 'string' && DATE_RE.test(value) ? value : null;\n  }\n\n  function isOverdue(todo) {\n    var due = validDue(todo.due);\n    return due !== null && due < todayLocal();\n  }\n\n  // Priority rule: one of \"low\", \"med\", \"high\". Anything else (including todos\n  // saved before priorities existed) is treated as \"med\".\n  var PRIORITY_LABELS = { low: 'Low', med: 'Med', high: 'High' };\n\n  function validPriority(value) {\n    return PRIORITY_LABELS.hasOwnProperty(value) ? value : 'med';\n  }\n\n  function formatDue(due) {\n    var parts = due.split('-');\n    var year = Number(parts[0]);\n    var date = new Date(year, Number(parts[1]) - 1, Number(parts[2])); // Local date.\n    var options = { month: 'short', day: 'numeric' };\n    if (year !== new Date().getFullYear()) options.year = 'numeric';\n    return date.toLocaleDateString(undefined, options);\n  }\n\n  // Ordering rule (project decision): completed todos always appear below all\n  // active todos. Within each group, todos are sorted by priority (high, med,\n  // low); within the same priority they stay in insertion order (oldest first).\n  // `todos` is kept in insertion order; the index tiebreak keeps the sort stable.\n  var PRIORITY_RANK = { high: 0, med: 1, low: 2 };\n\n  function byPriority(group) {\n    return group\n      .map(function (t, i) { return { todo: t, index: i }; })\n      .sort(function (a, b) {\n        return PRIORITY_RANK[validPriority(a.todo.priority)] - PRIORITY_RANK[validPriority(b.todo.priority)] ||\n          a.index - b.index;\n      })\n      .map(function (entry) { return entry.todo; });\n  }\n\n  function ordered() {\n    var active = todos.filter(function (t) { return !t.completed; });\n    var completed = todos.filter(function (t) { return t.completed; });\n    return byPriority(active).concat(byPriority(completed));\n  }\n\n  function visible() {\n    return ordered().filter(function (t) {\n      if (filter === 'active') return !t.completed;\n      if (filter === 'completed') return !!t.completed;\n      return true;\n    });\n  }\n\n  // Rows are kept by id and reused across renders, so a checkbox the user just\n  // clicked stays the same element after the list is reordered or filtered.\n  var rows = {};\n\n  function createRow(todo) {\n    var li = document.createElement('li');\n    li.setAttribute('data-testid', 'todo-item');\n    li.setAttribute('data-id', todo.id);\n\n    var toggle = document.createElement('input');\n    toggle.type = 'checkbox';\n    toggle.className = 'toggle';\n    toggle.setAttribute('data-testid', 'todo-toggle');\n    toggle.addEventListener('change', function () {\n      toggleTodo(todo.id);\n    });\n\n    var content = document.createElement('div');\n    content.className = 'content';\n\n    var text = document.createElement('span');\n    text.className = 'text';\n    text.setAttribute('data-testid', 'todo-text');\n    text.textContent = todo.text;\n\n    var due = document.createElement('time');\n    due.className = 'due';\n    due.setAttribute('data-testid', 'todo-due-date');\n\n    content.appendChild(text);\n    content.appendChild(due);\n\n    var priority = document.createElement('span');\n    priority.className = 'priority';\n\n    var del = document.createElement('button');\n    del.type = 'button';\n    del.className = 'delete';\n    del.setAttribute('data-testid', 'todo-delete');\n    del.setAttribute('aria-label', 'Delete \"' + todo.text + '\"');\n    del.textContent = 'Delete';\n    del.addEventListener('click', function () {\n      removeTodo(todo.id);\n    });\n\n    li.appendChild(toggle);\n    li.appendChild(content);\n    li.appendChild(priority);\n    li.appendChild(del);\n    return li;\n  }\n\n  function render() {\n    var items = visible();\n    var keep = {};\n\n    items.forEach(function (todo) {\n      var li = rows[todo.id] || (rows[todo.id] = createRow(todo));\n      var toggle = li.querySelector('.toggle');\n      var dueLabel = li.querySelector('.due');\n      var due = validDue(todo.due);\n      var overdue = isOverdue(todo);\n      var priority = validPriority(todo.priority);\n      var priorityLabel = li.querySelector('.priority');\n      li.setAttribute('data-priority', priority);\n      priorityLabel.textContent = PRIORITY_LABELS[priority];\n      priorityLabel.setAttribute('aria-label', PRIORITY_LABELS[priority] + ' priority');\n      li.setAttribute('data-completed', todo.completed ? 'true' : 'false');\n      li.setAttribute('data-overdue', overdue ? 'true' : 'false');\n      dueLabel.hidden = due === null;\n      if (due === null) {\n        dueLabel.removeAttribute('datetime');\n        dueLabel.textContent = '';\n      } else {\n        dueLabel.setAttribute('datetime', due);\n        dueLabel.textContent = (overdue ? 'Overdue \\u00b7 ' : 'Due ') + formatDue(due);\n      }\n      toggle.checked = !!todo.completed;\n      toggle.setAttribute('aria-label', 'Mark \"' + todo.text + '\" as ' + (todo.completed ? 'not done' : 'done'));\n      keep[todo.id] = true;\n      list.appendChild(li); // Moves an existing row into place.\n    });\n\n    Object.keys(rows).forEach(function (id) {\n      if (keep[id]) return;\n      if (rows[id].parentNode) rows[id].parentNode.removeChild(rows[id]);\n      if (!todos.some(function (t) { return t.id === id; })) delete rows[id];\n    });\n\n    filterButtons.forEach(function (button) {\n      button.setAttribute('aria-pressed', button.getAttribute('data-filter') === filter ? 'true' : 'false');\n    });\n\n    if (todos.length === 0) {\n      empty.textContent = 'Nothing here yet.';\n    } else if (filter === 'active') {\n      empty.textContent = 'All done.';\n    } else if (filter === 'completed') {\n      empty.textContent = 'Nothing completed yet.';\n    }\n    empty.hidden = items.length > 0;\n  }\n\n  function addTodo(text, due, priority) {\n    todos.push({ id: newId(), text: text, completed: false, createdAt: Date.now(), due: due, priority: validPriority(priority) });\n    save();\n    render();\n  }\n\n  function removeTodo(id) {\n    todos = todos.filter(function (t) { return t.id !== id; });\n    save();\n    render();\n  }\n\n  function toggleTodo(id) {\n    todos.forEach(function (t) {\n      if (t.id === id) t.completed = !t.completed;\n    });\n    save();\n    render();\n  }\n\n  function setFilter(value) {\n    filter = value;\n    render();\n  }\n\n  filterButtons.forEach(function (button) {\n    button.addEventListener('click', function () {\n      setFilter(button.getAttribute('data-filter'));\n    });\n  });\n\n  form.addEventListener('submit', function (event) {\n    event.preventDefault();\n    var text = input.value.trim();\n    if (!text) return;\n    addTodo(text, validDue(dueInput.value), priorityInput.value);\n    input.value = '';\n    dueInput.value = '';\n    priorityInput.value = 'med';\n    input.focus();\n  });\n\n  // \"Today\" moves at local midnight; re-render so overdue flags stay current.\n  function scheduleMidnightRender() {\n    var now = new Date();\n    var next = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);\n    setTimeout(function () {\n      render();\n      scheduleMidnightRender();\n    }, next - now + 1000);\n  }\n\n  document.addEventListener('visibilitychange', function () {\n    if (!document.hidden) render();\n  });\n\n  render();\n  scheduleMidnightRender();\n})();\n</script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":54,"oldLines":14,"newStart":54,"newLines":7,"lines":["     background: #f2f2f4;","   }","   li:first-child { margin-top: 0; }","-  /* Priority colours: high red, med amber, low grey. */","-  li[data-priority=\"high\"] { background: #fdecec; }","-  li[data-priority=\"med\"] { background: #fff4de; }","-  li[data-priority=\"low\"] { background: #f2f2f4; }","-  .priority { flex: none; padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 600; }","-  li[data-priority=\"high\"] .priority { background: #f9d0d3; color: #b0000f; }","-  li[data-priority=\"med\"] .priority { background: #fde2ad; color: #8a5300; }","-  li[data-priority=\"