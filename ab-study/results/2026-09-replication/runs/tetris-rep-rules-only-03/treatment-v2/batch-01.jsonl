lue { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }\n  .preview {\n    display: grid;\n    grid-template-columns: repeat(4, 20px);\n    grid-template-rows: repeat(2, 20px);\n    gap: 1px;\n    margin-top: 6px;\n  }\n  .preview div { background: transparent; }\n  .p-I { background: var(--I) !important; }\n  .p-O { background: var(--O) !important; }\n  .p-T { background: var(--T) !important; }\n  .p-S { background: var(--S) !important; }\n  .p-Z { background: var(--Z) !important; }\n  .p-J { background: var(--J) !important; }\n  .p-L { background: var(--L) !important; }\n  button {\n    background: var(--panel); color: var(--text); border: 1px solid var(--grid);\n    border-radius: 6px; padding: 8px 12px; font: inherit; cursor: pointer;\n  }\n  button:hover { border-color: var(--muted); }\n  .keys { color: var(--muted); font-size: 13px; }\n</style>\n</head>\n<body>\n<div class=\"game\">\n  <div class=\"board\" data-testid=\"board\" id=\"board\"></div>\n  <div class=\"side\">\n    <div class=\"box\"><div class=\"label\">Score</div><div class=\"value\" data-testid=\"score\" id=\"score\">0</div></div>\n    <div class=\"box\"><div class=\"label\">Level</div><div class=\"value\" data-testid=\"level\" id=\"level\">1</div></div>\n    <div class=\"box\"><div class=\"label\">Lines</div><div class=\"value\" data-testid=\"lines\" id=\"lines\">0</div></div>\n    <div class=\"box\"><div class=\"label\">Next</div><div class=\"preview\" id=\"preview\"></div></div>\n    <button id=\"restart\" type=\"button\">New game</button>\n    <div class=\"keys\">← → move<br>↓ soft drop<br>Space hard drop</div>\n  </div>\n</div>\n<script>\n(function () {\n  \"use strict\";\n\n  var ROWS = 20, COLS = 10;\n  var TYPES = [\"I\", \"O\", \"T\", \"S\", \"Z\", \"J\", \"L\"];\n\n  // Spawn shapes as [row, col] offsets from the piece origin.\n  var SHAPES = {\n    I: [[0, 0], [0, 1], [0, 2], [0, 3]],\n    O: [[0, 1], [0, 2], [1, 1], [1, 2]],\n    T: [[0, 1], [1, 0], [1, 1], [1, 2]],\n    S: [[0, 1], [0, 2], [1, 0], [1, 1]],\n    Z: [[0, 0], [0, 1], [1, 1], [1, 2]],\n    J: [[0, 0], [1, 0], [1, 1], [1, 2]],\n    L: [[0, 2], [1, 0], [1, 1], [1, 2]]\n  };\n  var SPAWN_COL = 3;\n  var GRAVITY_MS = 1000;\n\n  var state = {\n    board: [],      // ROWS x COLS, \"\" or piece letter\n    current: null,  // { type, row, col }\n    next: [],\n    score: 0,\n    level: 1,\n    lines: 0,\n    status: \"running\"\n  };\n\n  // ---- core logic ----\n\n  function emptyBoard() {\n    var b = [];\n    for (var r = 0; r < ROWS; r++) {\n      var row = [];\n      for (var c = 0; c < COLS; c++) row.push(\"\");\n      b.push(row);\n    }\n    return b;\n  }\n\n  function randomType() {\n    return TYPES[Math.floor(Math.random() * TYPES.length)];\n  }\n\n  function cellsOf(piece, dRow, dCol) {\n    return SHAPES[piece.type].map(function (o) {\n      return [piece.row + (dRow || 0) + o[0], piece.col + (dCol || 0) + o[1]];\n    });\n  }\n\n  function fits(piece, dRow, dCol) {\n    return cellsOf(piece, dRow, dCol).every(function (p) {\n      return p[0] >= 0 && p[0] < ROWS && p[1] >= 0 && p[1] < COLS && state.board[p[0]][p[1]] === \"\";\n    });\n  }\n\n  function spawn() {\n    var type = state.next.length ? state.next.shift() : randomType();\n    if (!state.next.length) state.next.push(randomType());\n    state.current = { type: type, row: 0, col: SPAWN_COL };\n  }\n\n  function lock() {\n    var piece = state.current;\n    cellsOf(piece).forEach(function (p) { state.board[p[0]][p[1]] = piece.type; });\n    state.current = null;\n    spawn();\n  }\n\n  function tryMove(dRow, dCol) {\n    if (!state.current || !fits(state.current, dRow, dCol)) return false;\n    state.current.row += dRow;\n    state.current.col += dCol;\n    return true;\n  }\n\n  // One gravity step. The timer and __tetris.tick both call this.\n  function gravityStep() {\n    if (state.status !== \"running\" || !state.current) return;\n    if (!tryMove(1, 0)) lock();\n  }\n\n  var actions = {\n    left: function () { tryMove(0, -1); },\n    right: function () { tryMove(0, 1); },\n    softDrop: function () { tryMove(1, 0); },\n    hardDrop: function () {\n      if (!state.current) return;\n      while (tryMove(1, 0)) {}\n      lock();\n    }\n  };\n\n  function doAction(name) {\n    if (state.status !== \"running\" || !actions[name]) return;\n    actions[name]();\n    render();\n  }\n\n  function newGame(queue) {\n    state.board = emptyBoard();\n    state.score = 0;\n    state.level = 1;\n    state.lines = 0;\n    state.status = \"running\";\n    state.next = Array.isArray(queue) ? queue.slice() : [];\n    spawn();\n    restartTimer();\n    render();\n  }\n\n  // ---- rendering (synchronous) ----\n\n  var boardEl = document.getElementById(\"board\");\n  var previewEl = document.getElementById(\"preview\");\n  var scoreEl = document.getElementById(\"score\");\n  var levelEl = document.getElementById(\"level\");\n  var linesEl = document.getElementById(\"lines\");\n  var cellEls = [];\n  var previewEls = [];\n\n  (function buildDom() {\n    for (var r = 0; r < ROWS; r++) {\n      var row = [];\n      for (var c = 0; c < COLS; c++) {\n        var el = document.createElement(\"div\");\n        el.className = \"cell\";\n        el.setAttribute(\"data-testid\", \"cell\");\n        el.setAttribute(\"data-row\", String(r));\n        el.setAttribute(\"data-col\", String(c));\n        el.setAttribute(\"data-filled\", \"false\");\n        el.setAttribute(\"data-piece\", \"\");\n        boardEl.appendChild(el);\n        row.push(el);\n      }\n      cellEls.push(row);\n    }\n    for (var i = 0; i < 8; i++) {\n      var p = document.createElement(\"div\");\n      previewEl.appendChild(p);\n      previewEls.push(p);\n    }\n  })();\n\n  function paint(el, type) {\n    el.className = el.className.replace(/\\s*p-[A-Z]/g, \"\") + (type ? \" p-\" + type : \"\");\n  }\n\n  function render() {\n    var view = state.board.map(function (row) { return row.slice(); });\n    if (state.current) {\n      cellsOf(state.current).forEach(function (p) {\n        if (p[0] >= 0 && p[0] < ROWS && p[1] >= 0 && p[1] < COLS) view[p[0]][p[1]] = state.current.type;\n      });\n    }\n    for (var r = 0; r < ROWS; r++) {\n      for (var c = 0; c < COLS; c++) {\n        var el = cellEls[r][c], t = view[r][c];\n        el.setAttribute(\"data-filled\", t ? \"true\" : \"false\");\n        el.setAttribute(\"data-piece\", t);\n        paint(el, t);\n      }\n    }\n    previewEls.forEach(function (el) { paint(el, \"\"); });\n    var nextType = state.next[0];\n    if (nextType) {\n      SHAPES[nextType].forEach(function (o) { paint(previewEls[o[0] * 4 + o[1]], nextType); });\n    }\n    scoreEl.textContent = String(state.score);\n    levelEl.textContent = String(state.level);\n    linesEl.textContent = String(state.lines);\n  }\n\n  // ---- timer ----\n\n  var timer = null;\n  function onTimer() { gravityStep(); render(); }\n  function restartTimer() {\n    if (timer) clearInterval(timer);\n    timer = setInterval(onTimer, GRAVITY_MS);\n  }\n\n  // ---- input ----\n\n  var KEYS = { ArrowLeft: \"left\", ArrowRight: \"right\", ArrowDown: \"softDrop\", \" \": \"hardDrop\" };\n  document.addEventListener(\"keydown\", function (e) {\n    var action = KEYS[e.key];\n    if (!action) return;\n    e.preventDefault();\n    doAction(action);\n  });\n  document.getElementById(\"restart\").addEventListener(\"click\", function (e) {\n    e.currentTarget.blur();\n    newGame();\n  });\n\n  // ---- test control surface ----\n\n  window.__tetris = {\n    newGame: function (queue) { newGame(queue); },\n    setQueue: function (queue) {\n      state.next = Array.isArray(queue) ? queue.slice() : [];\n      render();\n    },\n    setBoard: function (rows) {\n      state.board = rows.map(function (line) {\n        return line.split(\"\").map(function (ch) { return ch === \".\" ? \"\" : ch; });\n      });\n      render();\n    },\n    tick: function (n) {\n      var steps = n === undefined ? 1 : n;\n      for (var i = 0; i < steps; i++) gravityStep();\n      render();\n    },\n    input: function (action) { doAction(action); },\n    getBoard: function () {\n      return state.board.map(function (row) {\n        return row.map(function (t) { return t || \".\"; }).join(\"\");\n      });\n    },\n    getState: function () {\n      return {\n        current: state.current\n          ? { type: state.current.type, cells: cellsOf(state.current) }\n          : null,\n        next: state.next.slice(),\n        score: state.score,\n        level: state.level,\n        lines: state.lines,\n        status: state.status\n      };\n    }\n  };\n\n  newGame();\n})();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false}}
