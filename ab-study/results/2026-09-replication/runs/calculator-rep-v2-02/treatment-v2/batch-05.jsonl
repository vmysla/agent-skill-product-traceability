splay.setAttribute('data-error', state.error ? 'true' : 'false');\n    document.querySelectorAll('button[data-op]').forEach(function (b) {\n      b.classList.toggle('active', state.fresh && state.op === b.getAttribute('data-op'));\n    });\n  }\n\n  // [REQ-001]\n  // [REQ-003] Division by zero (non-finite result) enters the error state.\n  // String(value) is exact: Number(String(v)) === v.\n  function setResult(value) {\n    if (!isFinite(value)) {\n      state.error = true;\n      state.entry = '0';\n      state.stored = null;\n      state.op = null;\n    } else {\n      state.entry = String(value);\n    }\n    state.typed = false;\n    state.fresh = true;\n  }\n\n  // [REQ-001]\n  // [REQ-003] Ignored in the error state; only clear leaves it.\n  // [REQ-004] A value set by ± or % is finished: the next digit starts a new entry.\n  function inputDigit(d) {\n    if (state.error) return;\n    if (state.fresh || !state.typed) {\n      state.entry = d;\n      state.fresh = false;\n    } else if (state.entry === '0' || state.entry === '-0') {\n      state.entry = state.entry.slice(0, -1) + d;\n    } else {\n      state.entry += d;\n    }\n    state.typed = true;\n  }\n\n  // [REQ-001]\n  // [REQ-003] Ignored in the error state.\n  function inputDot() {\n    if (state.error) return;\n    if (state.fresh || !state.typed) {\n      state.entry = '0.';\n      state.fresh = false;\n    } else if (state.entry.indexOf('.') === -1) {\n      state.entry += '.';\n    }\n    state.typed = true;\n  }\n\n  // [REQ-004] ± flips the current entry. While typing it flips the text, so\n  // typing continues. Otherwise the flipped value becomes the current operand.\n  function toggleSign() {\n    if (state.error) return;\n    if (state.typed && !state.fresh) {\n      state.entry = state.entry.charAt(0) === '-' ? state.entry.slice(1) : '-' + state.entry;\n    } else {\n      setOperand(-Number(state.entry));\n    }\n  }\n\n  // [REQ-004] % divides the current entry by 100; the result is the current operand.\n  function percent() {\n    if (state.error) return;\n    setOperand(Number(state.entry) / 100);\n  }\n\n  // [REQ-004] A finished value that counts as the right operand if an operator\n  // is waiting (so 2 + 50 % = is 2.5), and is replaced by the next digit.\n  function setOperand(value) {\n    state.entry = String(value);\n    state.typed = false;\n    state.fresh = false;\n  }\n\n  // [REQ-001]\n  // [REQ-002] Immediate execution: an operator key first finishes the waiting\n  // operation, strictly left to right, no precedence. 2 + 3 × 4 = is 20.\n  function inputOperator(op) {\n    if (state.error) return;\n    if (state.op !== null && !state.fresh) {\n      setResult(compute(state.stored, state.op, Number(state.entry)));\n      if (state.error) return;\n    }\n    state.stored = Number(state.entry);\n    state.op = op;\n    state.fresh = true;\n  }\n\n  // [REQ-001]\n  function equals() {\n    if (state.error || state.op === null) return;\n    var result = compute(state.stored, state.op, Number(state.entry));\n    state.stored = null;\n    state.op = null;\n    setResult(result);\n  }\n\n  // [REQ-001]\n  function clearAll() {\n    state.entry = '0';\n    state.stored = null;\n    state.op = null;\n    state.fresh = true;\n    state.typed = false;\n    state.error = false;\n  }\n\n  document.querySelector('.keys').addEventListener('click', function (e) {\n    var btn = e.target.closest('button');\n    if (!btn) return;\n    var id = btn.getAttribute('data-testid');\n    if (/^key-\\d$/.test(id)) inputDigit(id.slice(4));\n    else if (id === 'key-dot') inputDot();\n    else if (id === 'key-sign') toggleSign();\n    else if (id === 'key-percent') percent();\n    else if (id === 'key-equals') equals();\n    else if (id === 'key-clear') clearAll();\n    else if (btn.hasAttribute('data-op')) inputOperator(btn.getAttribute('data-op'));\n    render();\n  });\n\n  render();\n</script>\n</body>\n</html>\n","numLines":258,"startLine":1,"totalLines":2