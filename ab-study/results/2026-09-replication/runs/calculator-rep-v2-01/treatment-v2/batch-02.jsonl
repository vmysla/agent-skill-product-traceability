]\n  function compute(a, op, b) {\n    var r;\n    if (op === 'add') r = a + b;\n    else if (op === 'sub') r = a - b;\n    else if (op === 'mul') r = a * b;\n    else if (op === 'div') r = a / b;\n    if (!isFinite(r)) return NaN;\n    // Trim floating-point noise such as 0.1 + 0.2.\n    return parseFloat(r.toPrecision(12));\n  }\n\n  // [REQ-001]\n  function render() {\n    if (state.error) {\n      display.textContent = 'Error';\n      display.setAttribute('data-value', String(NaN));\n      return;\n    }\n    if (state.entry !== null) {\n      display.textContent = state.entry;\n      display.setAttribute('data-value', String(Number(state.entry)));\n    } else {\n      display.textContent = String(state.value);\n      display.setAttribute('data-value', String(state.value));\n    }\n  }\n\n  // [REQ-001]\n  function inputDigit(d) {\n    if (state.error) reset();\n    if (state.entry === null || state.entry === '0') state.entry = d;\n    else state.entry += d;\n  }\n\n  // [REQ-001]\n  function inputDot() {\n    if (state.error) reset();\n    if (state.entry === null) state.entry = '0.';\n    else if (state.entry.indexOf('.') === -1) state.entry += '.';\n  }\n\n  // [REQ-001]\n  function inputOperator(op) {\n    if (state.error) return;\n    if (state.entry !== null) {\n      var n = Number(state.entry);\n      state.entry = null;\n      if (state.op !== null && state.stored !== null) {\n        state.value = compute(state.stored, state.op, n);\n        if (isNaN(state.value)) { state.error = true; return; }\n      } else {\n        state.value = n;\n      }\n    }\n    state.stored = state.value;\n    state.op = op;\n  }\n\n  // [REQ-001]\n  function inputEquals() {\n    if (state.error || state.op === null || state.entry === null) return;\n    var result = compute(state.stored, state.op, Number(state.entry));\n    state.entry = null;\n    state.op = null;\n    state.stored = null;\n    if (isNaN(result)) { state.error = true; return; }\n    state.value = result;