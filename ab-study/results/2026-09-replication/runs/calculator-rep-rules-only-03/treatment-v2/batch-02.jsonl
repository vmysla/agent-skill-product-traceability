}\n  .clear { background: #6b7280; }\n  .equals { background: #10b981; }\n  .wide { grid-column: span 2; }\n</style>\n</head>\n<body>\n<div class=\"calc\">\n  <div class=\"display\" data-testid=\"calc-display\" data-value=\"0\">0</div>\n  <div class=\"keys\">\n    <button class=\"clear wide\" data-testid=\"key-clear\" data-action=\"clear\">AC</button>\n    <button class=\"op\" data-testid=\"key-div\" data-op=\"/\">÷</button>\n    <button class=\"op\" data-testid=\"key-mul\" data-op=\"*\">×</button>\n    <button data-testid=\"key-7\" data-digit=\"7\">7</button>\n    <button data-testid=\"key-8\" data-digit=\"8\">8</button>\n    <button data-testid=\"key-9\" data-digit=\"9\">9</button>\n    <button class=\"op\" data-testid=\"key-sub\" data-op=\"-\">−</button>\n    <button data-testid=\"key-4\" data-digit=\"4\">4</button>\n    <button data-testid=\"key-5\" data-digit=\"5\">5</button>\n    <button data-testid=\"key-6\" data-digit=\"6\">6</button>\n    <button class=\"op\" data-testid=\"key-add\" data-op=\"+\">+</button>\n    <button data-testid=\"key-1\" data-digit=\"1\">1</button>\n    <button data-testid=\"key-2\" data-digit=\"2\">2</button>\n    <button data-testid=\"key-3\" data-digit=\"3\">3</button>\n    <button class=\"equals\" data-testid=\"key-equals\" data-action=\"equals\">=</button>\n    <button class=\"wide\" data-testid=\"key-0\" data-digit=\"0\">0</button>\n    <button data-testid=\"key-dot\" data-action=\"dot\">.</button>\n  </div>\n</div>\n<script>\n  // State: acc = stored left operand, op = pending operator,\n  // entry = digits being typed (string) or null, value = number shown.\n  var state = { acc: null, op: null, entry: null, value: 0, error: false };\n\n  function compute(a, op, b) {\n    var r;\n    if (op === '+') r = a + b;\n    else if (op === '-') r = a - b;\n    else if (op === '*') r = a * b;\n    else r = a / b;\n    if (!isFinite(r)) return NaN;\n    return parseFloat(r.toPrecision(12));\n  }\n\n  function pressDigit(d) {\n    if (state.error) clear();\n    if (state.entry === null || state.entry === '0') state.entry = d;\n    else state.entry += d;\n    state.value = Number(state.entry);\n  }\n\n  function pressDot() {\n    if (state.error) clear();\n    if (state.entry === null) state.entry = '0';\n    if (state.entry.indexOf('.') === -1) state.entry += '.';\n    state.value = Number(state.entry);\n  }\n\n  function resolve() {\n    if (state.op !== null && state.entry !== null) {\n      state.value = compute(state.acc, state.op, state.value);\n      if (isNaN(state.value)) state.error = true;\n    }\n  }\n\n  function pressOp(op) {\n    if (state.error) return;\n    resolve();\n    if (state.error) return;\n    state.acc = state.value;\n    state.op = op;\n    state.entry = null;\n  }\n\n  function pressEquals() {\n    if (state.error) return;\n    resolve();\n    state.acc = null;\n    state.op = null;\n    state.entry = null;\n  }\n\n  function clear() {\n    state = { acc: null, op: null, entry: null, value: 0, error: false };\n  }\n\n  var display = document.querySelector('[data-testid=\"calc-display\"]');\n\n  function render() {\n    display.setAttribute('data-value', String(state.value));\n    if (state.error) display.textContent = 'Error';\n    else display.textContent = state.entry !== null ? state.entry : String(state.value);\n  }\n\n  document.querySelector('.keys').addEventListener('click', function (e) {\n    var b = e.target.closest('button');\n    if (!b) return;\n    if (b.dataset.digit !== undefined) pressDigit(b.dataset.digit);\n    else if (b.dataset.op) pressOp(b.dataset.op);\n    else if (b.dataset.action === 'dot') pressDot();\n    else if (b.dataset.action === 'equals') pressEquals();\n    else if (b.dataset.action === 'clear') clear();\n    render();\n  });\n\n  render();\n</script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":91,"oldLines":6,"newStart":91,"newLines":9,"lines":["     }","   }"," ","+  // Immediate execution, no precedence: each operator key first f