</div>\n76\t<script>\n77\t  var entry = \"0\";      // text of the current entry or last result\n78\t  var stored = null;    // left operand\n79\t  var op = null;        // pending operator\n80\t  var fresh = true;     // next digit starts a new entry\n81\t  var waiting = false;  // an operator was just pressed and has no right operand yet\n82\t  var error = false;    // set by a non-finite result; only clear leaves it\n83\t  var groups = [];      // outer {stored, op} saved by each open parenthesis\n84\t  var parts = [];       // expression text of the current group, for the tape\n85\t  var partGroups = [];  // outer parts saved by each open parenthesis\n86\t  var operandText = null; // text of a just-closed group, standing in for the entry\n87\t  var SYMBOLS = { \"+\": \"+\", \"-\": \"\\u2212\", \"*\": \"\\u00d7\", \"/\": \"\\u00f7\" };\n88\t\n89\t  var display = document.querySelector('[data-testid=\"calc-display\"]');\n90\t  var tapeList = document.querySelector(\".tape-list\");\n91\t\n92\t  // Text of the current right operand as it belongs in the expression.\n93\t  function operandString() {\n94\t    if (operandText !== null) return operandText;\n95\t    return fresh ? format(Number(entry)) : entry.replace(/\\.$/, \"\");\n96\t  }\n97\t\n98\t  function addTapeRow(expr, value) {\n99\t    var row = document.createElement(\"div\");\n100\t    row.className = \"tape-row\";\n101\t    row.setAttribute(\"data-testid\", \"tape-row\");\n102\t    var e = document.createElement(\"div\");\n103\t    e.className = \"tape-expr\";\n104\t    e.setAttribute(\"data-testid\", \"tape-expr\");\n105\t    e.textContent = expr;\n106\t    var r = document.createElement(\"div\");\n107\t    r.className = \"tape-result\";\n108\t    r.setAttribute(\"data-testid\", \"tape-result\");\n109\t    r.setAttribute(\"data-value\", String(value));\n110\t    r.textContent = format(value);\n111\t    row.appendChild(e);\n112\t    row.appendChild(r);\n113\t    tapeList.insertBefore(row, tapeList.firstChil