 0 auto; }\n  h1 { margin: 0 0 1rem; font-size: 1.5rem; }\n  form { display: flex; gap: .5rem; margin-bottom: 1rem; }\n  input { flex: 1; padding: .5rem .75rem; font: inherit; border: 1px solid #ccc; border-radius: 6px; }\n  button { padding: .5rem .9rem; font: inherit; border: 1px solid #bbb; border-radius: 6px; background: #fff; cursor: pointer; }\n  button:hover { background: #eee; }\n  ul { list-style: none; margin: 0; padding: 0; }\n  li { display: flex; align-items: center; gap: .5rem; padding: .5rem .75rem; margin-bottom: .4rem; background: #fff; border: 1px solid #e2e2e2; border-radius: 6px; }\n  li span { flex: 1; overflow-wrap: anywhere; }\n  li[data-completed=\"true\"] span { text-decoration: line-through; color: #888; }\n  li input[type=\"checkbox\"] { flex: none; width: 1.1rem; height: 1.1rem; margin: 0; }\n  .filters { display: flex; gap: .5rem; margin-bottom: 1rem; }\n  .filters button[aria-pressed=\"true\"] { background: #222; border-color: #222; color: #fff; }\n</style>\n</head>\n<body>\n<main>\n  <h1>Todos</h1>\n  <form id=\"todo-form\">\n    <input data-testid=\"todo-input\" type=\"text\" placeholder=\"What needs doing?\" aria-label=\"New todo\" autocomplete=\"off\">\n    <button data-testid=\"todo-add\" type=\"submit\">Add</button>\n  </form>\n  <div class=\"filters\" role=\"group\" aria-label=\"Filter todos\">\n    <button data-testid=\"filter-all\" type=\"button\" data-filter=\"all\" aria-pressed=\"true\">All</button>\n    <button data-testid=\"filter-active\" type=\"button\" data-filter=\"active\" aria-pressed=\"false\">Active</button>\n    <button data-testid=\"filter-completed\" type=\"button\" data-filter=\"completed\" aria-pressed=\"false\">Completed</button>\n  </div>\n  <ul data-testid=\"todo-list\"></ul>\n</main>\n<script>\n  var STORAGE_KEY = 'todos';\n  var form = document.getElementById('todo-form');\n  var input = document.querySelector('[data-testid=\"todo-input\"]');\n  var list = document.querySelector('[data-testid=\"todo-list\"]');\n  var filterButtons = document.querySelectorAll('[data-filter]');\n  var currentFilter = 'all';\n\n  // [REQ-001] Load todos from localStorage; ignore malformed data.\n  function loadTodos() {\n    try {\n      var parsed = JSON.parse(localStorage.getItem(STORAGE_KEY));\n      if (!Array.isArray(parsed)) return [];\n      // [REQ-002] Todos saved before completion existed default to active.\n      parsed.forEach(function (t) { t.completed = t.completed === true; });\n      return parsed;\n    } catch (e) {\n      return [];\n    }\n  }\n\n  // [REQ-001]\n  function saveTodos() {\n    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(todos)); } catch (e) {}\n  }\n\n  // [REQ-001] Stable unique id; crypto.randomUUID is not available in every file:// context.\n  function makeId() {\n    if (window.crypto && typeof crypto.randomUUID === 'function') {\n      try { return crypto.randomUUID(); } catch (e) {}\n    }\n    return Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);\n  }\n\n  // [REQ-002] Ordering decision: active todos first, completed below; insertion order within each group.\n  // The todos array is kept in insertion order, so a stable split preserves it.\n  function orderTodos(items) {\n    return items.filter(function (t) { return !t.completed; })\n      .concat(items.filter(function (t) { return t.completed; }));\n  }\n\n  // [REQ-002]\n  function matchesFilter(todo, filter) {\n    if (filter === 'active') return !todo.completed;\n    if (filter === 'completed') return todo.completed;\n    return true;\n  }\n\n  // [REQ-001] [REQ-002]\n  function render() {\n    list.textContent = '';\n    filterButtons.forEach(function (btn) {\n      btn.setAttribute('aria-pressed', String(btn.dataset.filter === currentFilter));\n    });\n    orderTodos(todos).filter(function (t) { return matchesFilter(t, currentFilter); }).forEach(function (todo) {\n      var li = document.createElement('li');\n      li.setAttribute('data-testid', 'todo-item');\n      li.setAttribute('data-completed', String(todo.completed));\n      li.dataset.id = todo.id;\n\n      var toggle = document.createElement('input');\n      toggle.type = 'checkbox';\n      toggle.setAttribute('data-testid', 'todo-toggle');\n      toggle.checked = todo.completed;\n      toggle.setAttribute('aria-label', 'Mark \"' + todo.text + '\" ' + (todo.completed ? 'incomplete' : 'complete'));\n      toggle.addEventListener('change', function () { toggleTodo(todo.id); });\n\n      var text = document.createElement('span');\n      text.setAttribute('data-testid', 'todo-text');\n      text.textContent = todo.text;\n\n      var del = document.createElement('button');\n      del.type = 'button';\n      del.setAttribute('data-testid', 'todo-delete');\n      del.textContent = 'Delete';\n      del.setAttribute('aria-label', 'Delete \"' + todo.text + '\"');\n      del.addEventListener('click', function () { deleteTodo(todo.id); });\n\n      li.appendChild(toggle);\n      li.appendChild(text);\n      li.appendChild(del);\n      list.appendChild(li);\n    });\n  }\n\n  // [REQ-001]\n  function addTodo(rawText) {\n    var text = rawText.trim();\n    if (!text) return;\n    todos.push({ id: makeId(), text: text, createdAt: Date.now(), completed: false });\n    saveTodos();\n    render();\n  }\n\n  // [REQ-001]\n  function deleteTodo(id) {\n    todos = todos.filter(function (t) { return t.id !== id; });\n    saveTodos();\n    render();\n  }\n\n  // [REQ-002] Flip completion in place; the array keeps insertion order.\n  function toggleTodo(id) {\n    todos.forEach(function (t) { if (t.id === id) t.completed = !t.completed; });\n    saveTodos();\n    render();\n  }\n\n  var todos = loadTodos();\n\n  filterButtons.forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      currentFilter = btn.dataset.filter;\n      render();\n    });\n  });\n\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    addTodo(input.value);\n    input.value = '';\n    input.focus();\n  });\n\n  render();\n</script>\n</body>\n</html>\n","numLines":167,"startLine":1,"totalLines":167}}}
