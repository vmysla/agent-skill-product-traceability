>Calculator</title>\n<style>\n  * { box-sizing: border-box; }\n  body {\n    margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;\n    background: #eceef1; font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  }\n  .calc {\n    width: min(320px, 100vw - 32px); padding: 16px; border-radius: 20px;\n    background: #1f2227; box-shadow: 0 12px 32px rgba(0,0,0,.25);\n  }\n  .display {\n    height: 80px; margin-bottom: 16px; padding: 0 12px; border-radius: 12px;\n    background: #2b2f36; color: #fff; font-size: 40px; text-align: right;\n    line-height: 80px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;\n  }\n  .keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }\n  button {\n    height: 60px; border: 0; border-radius: 12px; font-size: 22px; cursor: pointer;\n    background: #3a3f47; color: #fff;\n  }\n  button:active { filter: brightness(1.25); }\n  .op { background: #f59e0b; }\n  .clear { background: #9ca3af; color: #111; }\n  .wide { grid-column: span 2; }\n  .tape { margin-top: 16px; border-radius: 12px; background: #2b2f36; color: #fff; }\n  .tape-head {\n    display: flex; align-items: center; justify-content: space-between; padding: 8px 12px;\n    font-size: 13px; color: #9ca3af;\n  }\n  .tape-clear { height: auto; padding: 4px 10px; font-size: 13px; border-radius: 8px; }\n  .tape-list { max-height: 180px; overflow-y: auto; }\n  .tape-row { padding: 6px 12px; border-top: 1px solid #3a3f47; text-align: right; }\n  .tape-expr { font-size: 13px; color: #9ca3af; overflow-wrap: anywhere; }\n  .tape-result { font-size: 20px; }\n</style>\n</head>\n<body>\n<div class=\"calc\">\n  <div class=\"display\" data-testid=\"calc-display\" data-value=\"0\" data-error=\"false\">0</div>\n  <div class=\"keys\">\n    <button class=\"clear wide\" data-testid=\"key-clear\">AC</button>\n    <button class=\"clear\" data-testid=\"key-sign\">±</button>\n    <button class=\"op\" data-testid=\"key-div\" data-op=\"/\">÷</button>\n    <button class=\"clear wide\" data-testid=\"key-lparen\">(</button>\n    <button class=\"clear wide\" data-testid=\"key-rparen\">)</button>\n    <button data-testid=\"key-7\" data-digit=\"7\">7</button>\n    <button data-testid=\"key-8\" data-digit=\"8\">8</button>\n    <button data-testid=\"key-9\" data-digit=\"9\">9</button>\n    <button class=\"op\" data-testid=\"key-mul\" data-op=\"*\">×</button>\n    <button data-testid=\"key-4\" data-digit=\"4\">4</button>\n    <button data-testid=\"key-5\" data-digit=\"5\">5</button>\n    <button data-testid=\"key-6\" data-digit=\"6\">6</button>\n    <button class=\"op\" data-testid=\"key-sub\" data-op=\"-\">−</button>\n    <button data-testid=\"key-1\" data-digit=\"1\">1</button>\n    <button data-testid=\"key-2\" data-digit=\"2\">2</button>\n    <button data-testid=\"key-3\" data-digit=\"3\">3</button>\n    <button class=\"op\" data-testid=\"key-add\" data-op=\"+\">+</button>\n    <button class=\"wide\" data-testid=\"key-0\" data-digit=\"0\">0</button>\n    <button data-testid=\"key-dot\">.</button>\n    <button class=\"op\" data-testid=\"key-equals\">=</button>\n  </div>\n  <div class=\"tape\" data-testid=\"calc-tape\">\n    <div class=\"tape-head\">\n      <span>History</span>\n      <button class=\"tape-clear\" data-testid=\"tape-clear\">Clear</button>\n    </div>\n    <div class=\"tape-list\"></div>\n  </div>\n</div>\n<script>\n  var entry = \"0\";      // text of the current entry or last result\n  var stored = null;    // left operand\n  var op = null;        // pending operator\n  var fresh = true;     // next digit starts a new entry\n  var waiting = false;  // an operator was just pressed and has no right operand yet\n  var error = false;    // set by a non-finite result; only clear leaves it\n  var groups = [];      // outer {stored, op} saved by each open parenthesis\n  var parts = [];       // expression text of the current group, for the tape\n  var partGroups = [];  // outer parts saved by each open parenthesis\n  var operandText = null; // text of a just-closed group, standing in for the entry\n  var SYMBOLS = { \"+\": \"+\", \"-\": \"\\u2212\", \"*\": \"\\u00d7\", \"/\": \"\\u00f7\" };\n\n  var display = document.querySelector('[data-testid=\"calc-display\"]');\n  var tapeList = document.querySelector(\".tape-list\");\n\n  // Text of the current right operand as it belongs in the expression.\n  function operandString() {\n    if (operandText !== null) return operandText;\n    return fresh ? format(Number(entry)) : entry.replace(/\\.$/, \"\");\n  }\n\n  function addTapeRow(expr, value) {\n    var row = document.createElement(\"div\");\n    row.className = \"tape-row\";\n    row.setAttribute(\"data-testid\", \"tape-row\");\n    var e = document.createElement(\"div\");\n    e.className = \"tape-expr\";\n    e.setAttribute(\"data-testid\", \"tape-expr\");\n    e.textContent = expr;\n    var r = document.createElement(\"div\");\n    r.className = \"tape-result\";\n    r.setAttribute(\"data-testid\", \"tape-result\");\n    r.setAttribute(\"data-value\", String(value));\n    r.textContent = format(value);\n    row.appendChild(e);\n    row.appendChild(r);\n    tapeList.insertBefore(row, tapeList.firstChild);\n  }\n\n  function compute(a, b, o) {\n    if (o === \"+\") return a + b;\n    if (o === \"-\") return a - b;\n    if (o === \"*\") return a * b;\n    return a / b;\n  }\n\n  // Presentation only: at most 10 significant digits, no trailing zeros,\n  // exponential below 1e-9 or from 1e10. Stored values are never rounded.\n  function format(v) {\n    if (v === 0) return \"0\";\n    var r = Number(v.toPrecision(10));\n    var a = Math.abs(r);\n    if (a >= 1e10 || a < 1e-9) return r.toExponential();\n    var e = Math.floor(Math.log10(a));\n    if (Math.pow(10, e) > a) e--;\n    var s = r.toFixed(Math.max(0, 9 - e));\n    return s.indexOf(\".\") === -1 ? s : s.replace(/0+$/, \"\").replace(/\\.$/, \"\");\n  }\n\n  // While typing, the entry shows exactly as typed; results are formatted.\n  function render() {\n    display.textContent = error ? \"Error\" : fresh ? format(Number(entry)) : entry;\n    display.setAttribute(\"data-value\", String(Number(entry)));\n    display.setAttribute(\"data-error\", String(error));\n  }\n\n  function digit(d) {\n    if (fresh) { entry = d; fresh = false; }\n    else entry = entry === \"0\" || entry === \"-0\" ? entry.slice(0, -1) + d : entry + d;\n    waiting = false;\n    operandText = null;\n  }\n\n  function dot() {\n    if (fresh) { entry = \"0.\"; fresh = false; }\n    else if (entry.indexOf(\".\") === -1) entry += \".\";\n    waiting = false;\n    operandText = null;\n  }\n\n  // Acts on the current entry. A typed entry keeps its text; a result is negated as a value.\n  function sign() {\n    if (!fresh) entry = entry.charAt(0) === \"-\" ? entry.slice(1) : \"-\" + entry;\n    else entry = String(-Number(entry));\n    waiting = false;\n    operandText = null;\n  }\n\n  // Immediate execution: each operator finishes the waiting operation, strictly\n  // left to right, no precedence. 2 + 3 × 4 = is 20. The display always shows a real result.\n  function operator(o) {\n    if (waiting) parts[parts.length - 1] = SYMBOLS[o];\n    else parts.push(operandString(), SYMBOLS[o]);\n    operandText = null;\n    if (op !== null && !waiting) finish(compute(stored, Number(entry), op));\n    stored = Number(entry);\n    op = o;\n    fresh = true;\n    waiting = true;\n  }\n\n  // Division by zero (or any non-finite result) enters the error state.\n  function finish(result) {\n    entry = String(result);\n    if (!isFinite(result)) error = true;\n  }\n\n  // A group saves the outer operation and starts a fresh one inside.\n  // Inside a group the same left-to-right rule applies.\n  function lparen() {\n    partGroups.push(parts);\n    parts = []; operandText = null;\n    groups.push({ stored: stored, op: op });\n    entry = \"0\"; stored = null; op = null; fresh = true; waiting = false;\n  }\n\n  // Closing finishes the inner operation; its result becomes the outer right operand.\n  function rparen() {\n    if (groups.length === 0) return;\n    if (waiting) parts.pop();\n    else parts.push(operandString());\n    var inner = \"(\" + parts.join(\" \") + \")\";\n    parts = partGroups.pop();\n    operandText = inner;\n    if (op !== null && !waiting) finish(compute(stored, Number(entry), op));\n    var g = groups.pop();\n    stored = g.stored;\n    op = g.op;\n    fresh = true;\n    waiting = false;\n  }\n\n  // Equals closes any open groups first.\n  function equals() {\n    while (groups.length && !error) rparen();\n    if (op === null || error) return;\n    parts.push(operandString());\n    finish(compute(stored, Number(entry), op));\n    if (!error) addTapeRow(parts.join(\" \"), Number(entry));\n    parts = []; operandText = null;\n    stored = null;\n    op = null;\n    fresh = true;\n    waiting = false;\n  }\n\n  function clear() {\n    entry = \"0\"; stored = null; op = null; fresh = true; waiting = false; error = false; groups = [];\n    parts = []; partGroups = []; operandText = null;\n  }\n\n  document.querySelector(\".keys\").addEventListener(\"click\", function (e) {\n    var b = e.target.closest(\"button\");\n    if (!b) return;\n    var id = b.getAttribute(\"data-testid\");\n    if (error && id !== \"key-clear\") return;\n    if (b.hasAttribute(\"data-digit\")) digit(b.getAttribute(\"data-digit\"));\n    else if (b.hasAttribute(\"data-op\")) operator(b.getAttribute(\"data-op\"));\n    else if (id === \"key-dot\") dot();\n    else if (id === \"key-sign\") sign();\n    else if (id === \"key-lparen\") lparen();\n    else if (id === \"key-rparen\") rparen();\n    else if (id === \"key-equals\") equals();\n    else if (id === \"key-clear\") clear();\n    render();\n  });\n\n  // Clearing the tape leaves the calculator untouched.\n  document.querySelector('[data-testid=\"tape-clear\"]').addEventListener(\"click\", function () {\n    tapeList.textContent = \"\";\n  });\n\n  render();\n</script>\n</body>\n</html>\n","numLines":253,"startLine":1,"totalLines":253}}}
