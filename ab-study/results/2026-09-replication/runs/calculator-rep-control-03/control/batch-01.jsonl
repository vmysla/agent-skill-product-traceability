-display\" data-value=\"0\" aria-live=\"polite\">0</div>\n  <div class=\"keys\">\n    <button class=\"fn wide\" data-testid=\"key-clear\" data-action=\"clear\">AC</button>\n    <button class=\"op\" data-testid=\"key-div\" data-op=\"/\" aria-label=\"divide\">÷</button>\n    <button class=\"op\" data-testid=\"key-mul\" data-op=\"*\" aria-label=\"multiply\">×</button>\n\n    <button data-testid=\"key-7\" data-digit=\"7\">7</button>\n    <button data-testid=\"key-8\" data-digit=\"8\">8</button>\n    <button data-testid=\"key-9\" data-digit=\"9\">9</button>\n    <button class=\"op\" data-testid=\"key-sub\" data-op=\"-\" aria-label=\"subtract\">−</button>\n\n    <button data-testid=\"key-4\" data-digit=\"4\">4</button>\n    <button data-testid=\"key-5\" data-digit=\"5\">5</button>\n    <button data-testid=\"key-6\" data-digit=\"6\">6</button>\n    <button class=\"op\" data-testid=\"key-add\" data-op=\"+\" aria-label=\"add\">+</button>\n\n    <button data-testid=\"key-1\" data-digit=\"1\">1</button>\n    <button data-testid=\"key-2\" data-digit=\"2\">2</button>\n    <button data-testid=\"key-3\" data-digit=\"3\">3</button>\n    <button class=\"op\" data-testid=\"key-equals\" data-action=\"equals\" aria-label=\"equals\">=</button>\n\n    <button class=\"wide\" data-testid=\"key-0\" data-digit=\"0\">0</button>\n    <button data-testid=\"key-dot\" data-action=\"dot\" aria-label=\"decimal point\">.</button>\n  </div>\n</div>\n<script>\n(function () {\n  var display = document.querySelector('[data-testid=\"calc-display\"]');\n  var opButtons = document.querySelectorAll('[data-op]');\n\n  // entry: string being typed, or null when showing a stored value.\n  // value: number currently shown when entry is null.\n  var state;\n\n  function reset() {\n    state = { entry: null, value: 0, stored: null, op: null, error: false };\n  }\n\n  function compute(a, op, b) {\n    switch (op) {\n      case '+': return a + b;\n      case '-': return a - b;\n      case '*': return a * b;\n      case '/': return a / b;\n    }\n    return b;\n  }\n\n  function currentNumber() {\n    return state.entry !== null ? parseFloat(state.entry) : state.value;\n  }\n\n  function formatValue(n) {\n    var s = String(n);\n    if (s.length <= 12) return s;\n    // Trim floating-point noise and very long numbers for the visible text only.\n    var trimmed = String(parseFloat(n.toPrecision(12)));\n    if (trimmed.length <= 14) return trimmed;\n    return n.toExponential(6).replace(/\\.?0+e/, 'e');\n  }\n\n  function render() {\n    var text;\n    if (state.error) {\n      text = 'Error';\n    } else if (state.entry !== null) {\n      text = state.entry;\n    } else {\n      text = formatValue(state.value);\n    }\n    display.textContent = text;\n    display.setAttribute('data-value', state.error ? 'NaN' : String(currentNumber()));\n\n    var len = text.length;\n    display.style.fontSize = len > 12 ? '28px' : len > 9 ? '36px' : '48px';\n\n    for (var i = 0; i < opButtons.length; i++) {\n      var b = opButtons[i];\n      b.classList.toggle('active', state.entry === null && state.op === b.getAttribute('data-op'));\n    }\n  }\n\n  function inputDigit(d) {\n    if (state.error) reset();\n    if (state.entry === null || state.entry === '0') {\n      state.entry = d;\n    } else {\n      state.entry += d;\n    }\n  }\n\n  function inputDot() {\n    if (state.error) reset();\n    if (state.entry === null) {\n      state.entry = '0.';\n    } else if (state.entry.indexOf('.') === -1) {\n      state.entry += '.';\n    }\n  }\n\n  function setResult(n) {\n    if (!isFinite(n)) {\n      reset();\n      state.error = true;\n      return;\n    }\n    state.value = n;\n  }\n\n  function inputOp(op) {\n    if (state.error) return;\n    if (state.entry !== null) {\n      var n = parseFloat(state.entry);\n      state.entry = null;\n      if (state.op !== null && state.stored !== null) {\n        setResult(compute(state.stored, state.op, n));\n        if (state.error) return;\n      } else {\n        state.value = n;\n      }\n    }\n    state.stored = state.value;\n    state.op = op;\n  }\n\n  function equals() {\n    if (state.error || state.op === null) {\n      if (state.entry !== null) {\n        state.value = parseFloat(state.entry);\n        state.entry = null;\n      }\n      return;\n    }\n    var b = currentNumber();\n    state.entry = null;\n    var op = state.op;\n    state.op = null;\n    var a = state.stored;\n    state.stored = null;\n    setResult(compute(a, op, b));\n  }\n\n  document.querySelector('.keys').addEventListener('click', function (e) {\n    var btn = e.target.closest('button');\n    if (!btn) return;\n    if (btn.hasAttribute('data-digit')) inputDigit(btn.getAttribute('data-digit'));\n    else if (btn.hasAttribute('data-op')) inputOp(btn.getAttribute('data-op'));\n    else {\n      var action = btn.getAttribute('data-action');\n      if (action === 'dot') inputDot();\n      else if (action === 'equals') equals();\n      else if (action === 'clear') reset();\n    }\n    render();\n  });\n\n  document.addEventListener('keydown', function (e) {\n    if (e.ctrlKey || e.metaKey || e.altKey) return;\n    var k = e.key;\n    if (/^[0-9]$/.test(k)) inputDigit(k);\n    else if (k === '.' || k === ',') inputDot();\n    else if (k === '+' || k === '-' || k === '*' || k === '/') inputOp(k);\n    else if (k === 'Enter' || k === '=') equals();\n    else if (k === 'Escape' || k === 'c' || k === 'C') reset();\n    else return;\n    e.preventDefault();\n    render();\n  });\n\n  reset();\n  render();\n})();\n</script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":872,"cache_read_input_tokens":35747,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":872},"output_tokens":17,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},