l('[data-op]');\n\n  var state;\n\n  function reset() {\n    state = {\n      entry: '0',        // text of the number being shown / typed\n      stored: null,      // left operand\n      op: null,          // pending operator\n      typing: false,     // true while the user is building an entry\n      lastOp: null,      // for repeated equals\n      lastOperand: null,\n      error: false\n    };\n  }\n\n  // Trim floating-point noise such as 0.1 + 0.2 = 0.30000000000000004.\n  function clean(n) {\n    if (!isFinite(n)) return n;\n    return parseFloat(n.toPrecision(15));\n  }\n\n  function compute(a, op, b) {\n    switch (op) {\n      case '+': return clean(a + b);\n      case '-': return clean(a - b);\n      case '*': return clean(a * b);\n      case '/': return b === 0 ? NaN : clean(a / b);\n    }\n    return b;\n  }\n\n  function currentValue() {\n    return parseFloat(state.entry);\n  }\n\n  function render() {\n    var text, value;\n    if (state.error) {\n      text = 'Error';\n      value = 'NaN';\n    } else {\n      text = state.entry;\n      value = String(currentValue());\n    }\n    display.textContent = text;\n    display.setAttribute('data-value', value);\n    display.classList.toggle('small', text.length > 9 && text.length <= 13);\n    display.classList.toggle('tiny', text.length > 13);\n    for (var i = 0; i < opButtons.length; i++) {\n      var b = opButtons[i];\n      b.classList.toggle('active', !state.typing && state.op === b.getAttribute('data-op'));\n    }\n  }\n\n  function setResult(n) {\n    if (!isFinite(n)) {\n      reset();\n      state.error = true;\n    } else {\n      state.entry = String(n);\n    }\n  }\n\n  function inputDigit(d) {\n    if (state.error) reset();\n    if (!state.typing) {\n      state.entry = d;\n      state.typing = true;\n      if (state.op === null) state.lastOp = null;\n    } else if (state.entry === '0') {\n      state.entry = d;\n    } else if (state.entry.replace(/[-.]/g, '').length < 16) {\n      state.entry += d;\n    }\n  }\n\n  function inputDot() {\n    if (state.error) reset();\n    if (!state.typing) {\n      state.entry = '0.';\n      state.typing = true;\n      if (state.op === null) state.lastOp = null;\n    } else if (state.entry.indexOf('.') === -1) {\n      state.entry += '.';\n    }\n  }\n\n  function inputOp(op) {\n    if (state.error) return;\n    if (state.op !== null && state.typing) {\n      setResult(compute(state.stored, state.op, currentValue()));\n      if (state.error) return;\n    }\n    state.stored = currentValue();\n    state.op = op;\n    state.typing = false;\n    state.lastOp = null;\n  }\n\n  function equals() {\n    if (state.error) return;\n    if (state.op !== null) {\n      var b = state.typing ? currentValue() : state.stored;\n      state.lastOp = state.op;\n      state.lastOperand = b;\n      setResult(compute(state.stored, state.op, b));\n    } else if (state.lastOp !== null) {\n      setResult(compute(currentValue(), state.lastOp, state.lastOperand));\n    }\n    if (state.error) return;\n    state.op = null;\n    state.stored = null;\n    state.typing = false;\n  }\n\n  function handle(el) {\n    var digit = el.getAttribute('data-digit');\n    var op = el.getAttribute('data-op');\n    var action = el.getAttribute('data-action');\n    if (digit !== null) inputDigit(digit);\n    else if (op !== null) inputOp(op);\n    else if (action === 'dot') inputDot();\n    else if (action === 'equals') equals();\n    else if (action === 'clear') reset();\n    render();\n  }\n\n  document.querySelector('.keys').addEventListener('click', function (e) {\n    var el = e.target.closest('button');\n    if (el) handle(el);\n  });\n\n  var keyMap = {\n    '+': 'key-add', '-': 'key-sub', '*': 'key-mul', 'x': 'key-mul', '/': 'key-div',\n    '.': 'key-dot', ',': 'key-dot', '=': 'key-equals', 'Enter': 'key-equals',\n    'Escape': 'key-clear', 'c': 'key-clear', 'C': 'key-clear', 'Delete': 'key-clear'\n  };\n  document.addEventListener('keydown', function (e) {\n    if (e.ctrlKey || e.metaKey || e.altKey) return;\n    var id = /^[0-9]$/.test(e.key) ? 'key-' + e.key : keyMap[e.key];\n    if (!id) return;\n    e.preventDefault();\n    handle(document.querySelector('[data-testid=\"' + id + '\"]'));\n  });\n\n  reset();\n  render();\n})();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false}}
