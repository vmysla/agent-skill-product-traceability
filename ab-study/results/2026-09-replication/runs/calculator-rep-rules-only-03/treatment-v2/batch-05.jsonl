ll && (state.entry !== null || state.ready)) {\n133\t      state.value = compute(state.acc, state.op, state.value);\n134\t      if (isNaN(state.value)) state.error = true;\n135\t    }\n136\t  }\n137\t\n138\t  // Immediate execution, no precedence: each operator key first finishes the\n139\t  // waiting operation, strictly left to right, so the display always shows a\n140\t  // real running result. 2 + 3 × 4 = is 20, not 14.\n141\t  function pressOp(op) {\n142\t    if (state.error) return;\n143\t    resolve();\n144\t    if (state.error) return;\n145\t    state.acc = state.value;\n146\t    state.op = op;\n147\t    state.entry = null;\n148\t    state.ready = false;\n149\t  }\n150\t\n151\t  function pressEquals() {\n152\t    if (state.error) return;\n153\t    resolve();\n154\t    state.acc = null;\n155\t    state.op = null;\n156\t    state.entry = null;\n157\t    state.ready = false;\n158\t  }\n159\t\n160\t  function clear() {\n161\t    state = { acc: null, op: null, entry: null, value: 0, error: false, ready: false };\n162\t  }\n163\t\n164\t  var display = document.querySelector('[data-testid=\"calc-display\"]');\n165\t\n166\t  function render() {\n167\t    display.setAttribute('data-value', String(state.value));\n168\t    display.setAttribute('data-error', state.error ? 'true' : 'false');\n169\t    if (state.error) display.textContent = 'Error';\n170\t    else display.textContent = state.entry !== null ? state.entry : formatNumber(state.value);\n171\t  }\n172\t\n173\t  document.querySelector('.keys').addEventListener('click', function (e) {\n174\t    var b = e.target.closest('button');\n175\t    if (!b) return;\n176\t    if (b.dataset.digit !== undefined) pressDigit(b.dataset.digit);\n177\t    else if (b.dataset.op) pressOp(b.dataset.op);\n178\t    else if (b.dataset.action === 'dot') pressDot();\n179\t    else if (b.dataset.action === 'sign') pressSign();\n180\t    else if (b.dataset.action === 'percent') pressPercent();\n181\t    else if (b.dataset.action === 'equal