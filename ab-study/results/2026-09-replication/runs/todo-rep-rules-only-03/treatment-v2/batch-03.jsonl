<style>\n  body { font-family: system-ui, sans-serif; max-width: 32rem; margin: 2rem auto; padding: 0 1rem; color: #222; }\n  h1 { font-size: 1.5rem; }\n  form { display: flex; gap: .5rem; }\n  form input { flex: 1; padding: .5rem; font-size: 1rem; }\n  button { padding: .5rem .75rem; font-size: 1rem; cursor: pointer; }\n  ul { list-style: none; padding: 0; margin-top: 1rem; }\n  li { display: flex; align-items: center; gap: .5rem; padding: .5rem 0; border-bottom: 1px solid #ddd; }\n  li span { flex: 1; overflow-wrap: anywhere; }\n  li[data-completed=\"true\"] span { text-decoration: line-through; color: #888; }\n  .filters { display: flex; gap: .5rem; margin-top: 1rem; }\n  .filters button[aria-pressed=\"true\"] { font-weight: 600; }\n</style>\n</head>\n<body>\n<h1>Todos</h1>\n<form id=\"add-form\">\n  <input data-testid=\"todo-input\" type=\"text\" placeholder=\"What needs doing?\" autocomplete=\"off\">\n  <button data-testid=\"todo-add\" type=\"submit\">Add</button>\n</form>\n<div class=\"filters\">\n  <button data-testid=\"filter-all\" type=\"button\" data-filter=\"all\" aria-pressed=\"true\">All</button>\n  <button data-testid=\"filter-active\" type=\"button\" data-filter=\"active\" aria-pressed=\"false\">Active</button>\n  <button data-testid=\"filter-completed\" type=\"button\" data-filter=\"completed\" aria-pressed=\"false\">Completed</button>\n</div>\n<ul data-testid=\"todo-list\"></ul>\n<script>\n(function () {\n  var KEY = 'todos';\n  var input = document.querySelector('[data-testid=\"todo-input\"]');\n  var list = document.querySelector('[data-testid=\"todo-list\"]');\n  var form = document.getElementById('add-form');\n  var filterButtons = document.querySelectorAll('[data-filter]');\n  var filter = 'all';\n\n  function load() {\n    try {\n      var data = JSON.parse(localStorage.getItem(KEY));\n      return Array.isArray(data) ? data : [];\n    } catch (e) {\n      return [];\n    }\n  }\n\n  function save() {\n    try { localStorage.setItem(KEY, JSON.stringify(todos)); } catch (e) {}\n  }\n\n  function newId() {\n    if (window.crypto && typeof crypto.randomUUID === 'function') return crypto.randomUUID();\n    return Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);\n  }\n\n  // Project rule: active todos first, completed below; insertion order within each group.\n  function visibleTodos(all, f) {\n    var active = all.filter(function (t) { return !t.completed; });\n    var done = all.filter(function (t) { return !!t.completed; });\n    if (f === 'active') return active;\n    if (f === 'completed') return done;\n    return active.concat(done);\n  }\n\n  function render() {\n    list.textContent = '';\n    filterButtons.forEach(function (b) {\n      b.setAttribute('aria-pressed', String(b.dataset.filter === filter));\n    });\n    visibleTodos(todos, filter).forEach(function (todo) {\n      var li = document.createElement('li');\n      li.setAttribute('data-testid', 'todo-item');\n      li.setAttribute('data-completed', String(!!todo.completed));\n      li.dataset.id = todo.id;\n\n      var toggle = document.createElement('input');\n      toggle.setAttribute('data-testid', 'todo-toggle');\n      toggle.type = 'checkbox';\n      toggle.checked = !!todo.completed;\n      toggle.setAttribute('aria-label', 'Mark complete');\n      toggle.addEventListener('change', function () {\n        todo.completed = toggle.checked;\n        save();\n        render();\n      });\n\n      var text = document.createElement('span');\n      text.setAttribute('data-testid', 'todo-text');\n      text.textContent = todo.text;\n\n      var del = document.createElement('button');\n      del.setAttribute('data-testid', 'todo-delete');\n      del.type = 'button';\n      del.textContent = 'Delete';\n      del.addEventListener('click', function () {\n        todos = todos.filter(function (t) { return t.id !== todo.id; });\n        save();\n        render();\n      });\n\n      li.appendChild(toggle);\n      li.appendChild(text);\n      li.appendChild(del);\n      list.appendChild(li);\n    });\n  }\n\n  var todos = load();\n\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    var text = input.value.trim();\n    if (!text) return;\n    todos.push({ id: newId(), text: text, completed: false, createdAt: Date.now() });\n    save();\n    render();\n    input.value = '';\n    input.focus();\n  });\n\n  filterButtons.forEach(function (b) {\n    b.addEventListener('click', function () {\n      filter = b.dataset.filter;\n      render();\n    });\n  });\n\n  render();\n})();\n</script>\n</body>\n</html>\n","numLines":137,"startLine":1,"totalLines":137}}}
