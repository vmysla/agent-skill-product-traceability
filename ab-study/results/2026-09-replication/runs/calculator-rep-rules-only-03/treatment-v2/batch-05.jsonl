=\"key-sign\" data-action=\"sign\">±</button>\n    <button class=\"clear\" data-testid=\"key-percent\" data-action=\"percent\">%</button>\n    <button class=\"op\" data-testid=\"key-div\" data-op=\"/\">÷</button>\n    <button data-testid=\"key-7\" data-digit=\"7\">7</button>\n    <button data-testid=\"key-8\" data-digit=\"8\">8</button>\n    <button data-testid=\"key-9\" data-digit=\"9\">9</button>\n    <button class=\"op\" data-testid=\"key-mul\" data-op=\"*\">×</button>\n    <button data-testid=\"key-4\" data-digit=\"4\">4</button>\n    <button data-testid=\"key-5\" data-digit=\"5\">5</button>\n    <button data-testid=\"key-6\" data-digit=\"6\">6</button>\n    <button class=\"op\" data-testid=\"key-sub\" data-op=\"-\">−</button>\n    <button data-testid=\"key-1\" data-digit=\"1\">1</button>\n    <button data-testid=\"key-2\" data-digit=\"2\">2</button>\n    <button data-testid=\"key-3\" data-digit=\"3\">3</button>\n    <button class=\"op\" data-testid=\"key-add\" data-op=\"+\">+</button>\n    <button class=\"wide\" data-testid=\"key-0\" data-digit=\"0\">0</button>\n    <button data-testid=\"key-dot\" data-action=\"dot\">.</button>\n    <button class=\"equals\" data-testid=\"key-equals\" data-action=\"equals\">=</button>\n  </div>\n</div>\n<script>\n  // State: acc = stored left operand, op = pending operator,\n  // entry = digits being typed (string) or null, value = number shown,\n  // ready = value is a finished right operand made by ± or %, not typed.\n  var state = { acc: null, op: null, entry: null, value: 0, error: false, ready: false };\n\n  function compute(a, op, b) {\n    var r;\n    if (op === '+') r = a + b;\n    else if (op === '-') r = a - b;\n    else if (op === '*') r = a * b;\n    else r = a / b;\n    if (!isFinite(r)) return NaN;\n    return r;\n  }\n\n  // Presentation only: stored values are never rounded. At most 10 significant\n  // digits, no trailing zeros, exponential only for |n| >= 1e10 or < 1e-9.\n  function formatNumber(n) {\n    if (n === 0) return '0';\n    var r = Number(n.toPrecision(10));\n    var abs = Math.abs(r);\n    if (abs >= 1e10 || abs < 1e-9) {\n      return r.toExponential(9).replace(/\\.?0+e/, 'e');\n    }\n    var exp = Number(r.toExponential(9).split('e')[1]);\n    var s = r.toFixed(Math.max(0, 9 - exp));\n    if (s.indexOf('.') !== -1) s = s.replace(/0+$/, '').replace(/\\.$/, '');\n    return s;\n  }\n\n  function pressDigit(d) {\n    if (state.error) return;\n    state.ready = false;\n    if (state.entry === null || state.entry === '0') state.entry = d;\n    else if (state.entry === '-0') state.entry = '-' + d;\n    else state.entry += d;\n    state.value = Number(state.entry);\n  }\n\n  function pressDot() {\n    if (state.error) return;\n    state.ready = false;\n    if (state.entry === null) state.entry = '0';\n    if (state.entry.indexOf('.') === -1) state.entry += '.';\n    state.value = Number(state.entry);\n  }\n\n  // While typing, ± toggles the sign of the typed digits so typing can go on.\n  // Otherwise it flips the shown value; with an operator waiting, that value\n  // becomes the right operand (5 + ± = is 0).\n  function pressSign() {\n    if (state.error) return;\n    if (state.entry !== null) {\n      state.entry = state.entry.charAt(0) === '-' ? state.entry.slice(1) : '-' + state.entry;\n      state.value = Number(state.entry);\n    } else {\n      state.value = -state.value;\n      state.ready = state.op !== null;\n    }\n  }\n\n  // % divides the shown value by 100 and ends typing; with an operator\n  // waiting, the result is the right operand (100 + 50 % = is 100.5).\n  function pressPercent() {\n    if (state.error) return;\n    state.value = state.value / 100;\n    state.entry = null;\n    state.ready = state.op !== null;\n  }\n\n  function resolve() {\n    if (state.op !== null && (state.entry !== null || state.ready)) {\n      state.value = compute(state.acc, state.op, state.value);\n      if (isNaN(state.value)) state.error = true;\n    }\n  }\n\n  // Immediate execution, no precedence: each operator key first finishes the\n  // waiting operation, strictly left to right, so the display always shows a\n  // real running result. 2 + 3 × 4 = is 20, not 14.\n  function pressOp(op) {\n    if (state.error) return;\n    resolve();\n    if (state.error) return;\n    state.acc = state.value;\n    state.op = op;\n    state.entry = null;\n    state.ready = false;\n  }\n\n  function pressEquals() {\n    if (state.error) return;\n    resolve();\n    state.acc = null;\n    state.op = null;\n    state.entry = null;\n    state.ready = false;\n  }\n\n  function clear() {\n    state = { acc: null, op: null, entry: null, value: 0, error: false, ready: false };\n  }\n\n  var display = document.querySelector('[data-testid=\"calc-display\"]');\n\n  function render() {\n    display.setAttribute('data-value', String(state.value));\n    display.setAttribute('data-error', state.error ? 'true' : 'false');\n    if (state.error) display.textContent = 'Error';\n    else display.textContent = state.entry !== null ? state.entry : formatNumber(state.value);\n  }\n\n  document.querySelector('.keys').addEventListener('click', function (e) {\n    var b = e.target.closest('button');\n    if (!b) return;\n    if (b.dataset.digit !== undefined) pressDigit(b.dataset.digit);\n    else if (b.dataset.op) pressOp(b.dataset.op);\n    else if (b.dataset.action === 'dot') pressDot();\n    else if (b.dataset.action === 'sign') pressSign();\n    else if (b.dataset.action === 'percent') pressPercent();\n    else if (b.dataset.action === 'equals') pressEquals();\n    else if (b.dataset.action === 'clear') clear();\n    render();\n  });\n\n  render();\n</script>\n</body>\n</html>\n","numLines":190,"startLine":1,"totalLines":190}}}
