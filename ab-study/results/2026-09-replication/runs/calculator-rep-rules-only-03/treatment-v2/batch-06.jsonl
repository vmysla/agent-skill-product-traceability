ddEventListener('click', function (e) {\n    var b = e.target.closest('button');\n    if (!b) return;\n    if (b.dataset.digit !== undefined) pressDigit(b.dataset.digit);\n    else if (b.dataset.op) pressOp(b.dataset.op);\n    else if (b.dataset.action === 'dot') pressDot();\n    else if (b.dataset.action === 'sign') pressSign();\n    else if (b.dataset.action === 'percent') pressPercent();\n    else if (b.dataset.action === 'lparen') pressLparen();\n    else if (b.dataset.action === 'rparen') pressRparen();\n    else if (b.dataset.action === 'equals') pressEquals();\n    else if (b.dataset.action === 'clear') clear();\n    render();\n  });\n\n  render();\n</script>\n</body>\n</html>\n","numLines":227,"startLine":1,"totalLines":227}}}
