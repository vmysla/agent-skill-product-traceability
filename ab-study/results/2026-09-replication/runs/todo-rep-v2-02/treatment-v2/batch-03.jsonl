ction orderTodos(items) {\n76\t    return items.filter(function (t) { return !t.completed; })\n77\t      .concat(items.filter(function (t) { return t.completed; }));\n78\t  }\n79\t\n80\t  // [REQ-002]\n81\t  function matchesFilter(todo, filter) {\n82\t    if (filter === 'active') return !todo.completed;\n83\t    if (filter === 'completed') return todo.completed;\n84\t    return true;\n85\t  }\n86\t\n87\t  // [REQ-001] [REQ-002]\n88\t  function render() {\n89\t    list.textContent = '';\n90\t    filterButtons.forEach(function (btn) {\n91\t      btn.setAttribute('aria-pressed', String(btn.dataset.filter === currentFilter));\n92\t    });\n93\t    orderTodos(todos).filter(function (t) { return matchesFilter(t, currentFilter); }).forEach(function (todo) {\n94\t      var li = document.createElement('li');\n95\t      li.setAttribute('data-testid', 'todo-item');\n96\t      li.setAttribute('data-completed', String(todo.completed));\n97\t      li.dataset.id = todo.id;\n98\t\n99\t      var toggle = document.createElement('input');\n100\t      toggle.type = 'checkbox';\n101\t      toggle.setAttribute('data-testid', 'todo-toggle');\n102\t      toggle.checked = todo.completed;\n103\t      toggle.setAttribute('aria-label', 'Mark \"' + todo.text + '\" ' + (todo.completed ? 'incomplete' : 'complete'));\n104\t      toggle.addEventListener('change', function () { toggleTodo(todo.id); });\n105\t\n106\t      var text = document.createElement('span');\n107\t      text.setAttribute('data-testid', 'todo-text');\n108\t      text.textContent = todo.text;\n109\t\n110\t      var del = document.createElement('button');\n111\t      del.type = 'button';\n112\t      del.setAttribute('data-testid', 'todo-delete');\n113\t      del.textContent = 'Delete';\n114\t      del.setAttribute('aria-label', 'Delete \"' + todo.text + '\"');\n115\t      del.addEventListener('click', function () { deleteTodo(todo.id); });\n116\t\n117\t      li.appendChild(toggle);\n118\t      li.appendChild(text);\n119\t      li.