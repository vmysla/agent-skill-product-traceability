n  // [REQ-001]\n  function render() {\n    if (state.error) {\n      display.textContent = 'Error';\n      display.setAttribute('data-value', String(NaN));\n      return;\n    }\n    if (state.entry !== null) {\n      display.textContent = state.entry;\n      display.setAttribute('data-value', String(Number(state.entry)));\n    } else {\n      display.textContent = String(state.value);\n      display.setAttribute('data-value', String(state.value));\n    }\n  }\n\n  // [REQ-001]\n  function inputDigit(d) {\n    if (state.error) reset();\n    if (state.entry === null || state.entry === '0') state.entry = d;\n    else state.entry += d;\n  }\n\n  // [REQ-001]\n  function inputDot() {\n    if (state.error) reset();\n    if (state.entry === null) state.entry = '0.';\n    else if (state.entry.indexOf('.') === -1) state.entry += '.';\n  }\n\n  // [REQ-001]\n  function inputOperator(op) {\n    if (state.error) return;\n    if (state.entry !== null) {\n      var n = Number(state.entry);\n      state.entry = null;\n      if (state.op !== null && state.stored !== null) {\n        state.value = compute(state.stored, state.op, n);\n        if (isNaN(state.value)) { state.error = true; return; }\n      } else {\n        state.value = n;\n      }\n    }\n    state.stored = state.value;\n    state.op = op;\n  }\n\n  // [REQ-001]\n  function inputEquals() {\n    if (state.error || state.op === null || state.entry === null) return;\n    var result = compute(state.stored, state.op, Number(state.entry));\n    state.entry = null;\n    state.op = null;\n    state.stored = null;\n    if (isNaN(result)) { state.error = true; return; }\n    state.value = result;\n  }\n\n  // [REQ-001]\n  function press(key) {\n    if (/^[0-9]$/.test(key)) inputDigit(key);\n    else if (key === 'dot') inputDot();\n    else if (key === 'add' || key === 'sub' || key === 'mul' || key === 'div') inputOperator(key);\n    else if (key === 'equals') inputEquals();\n    else if (key === 'clear') reset();\n    render();\n  }\n\n  document.querySelector('.keys').addEventListener('click', function (e) {\n    var btn = e.target.closest('button[data-testid^=\"key-\"]');\n    if (btn) press(btn.getAttribute('data-testid').slice(4));\n  });\n\n  var keyMap = { '.': 'dot', ',': 'dot', '+': 'add', '-': 'sub', '*': 'mul', 'x': 'mul',\n    '/': 'div', '=': 'equals', 'Enter': 'equals', 'Escape': 'clear', 'c': 'clear', 'C': 'clear' };\n  document.addEventListener('keydown', function (e) {\n    if (e.metaKey || e.ctrlKey || e.altKey) return;\n    var key = /^[0-9]$/.test(e.key) ? e.key : keyMap[e.key];\n    if (key) {\n      e.preventDefault();\n      press(key);\n    }\n  });\n\n  reset();\n  render();\n})();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false}}
