 '0' ? d : state.entry + d;\n    }\n    render();\n  }\n\n  // [REQ-001] at most one decimal point per entry\n  function inputDot() {\n    if (state.fresh) {\n      state.entry = '0.';\n      state.fresh = false;\n    } else if (state.entry.indexOf('.') === -1) {\n      state.entry += '.';\n    }\n    render();\n  }\n\n  // [REQ-001] store the operator; chains evaluate left to right\n  function inputOp(op) {\n    var current = Number(state.entry);\n    if (state.op !== null && !state.fresh) {\n      var result = compute(state.stored, state.op, current);\n      state.entry = String(result);\n      state.stored = result;\n    } else if (state.op === null) {\n      state.stored = current;\n    }\n    state.op = op;\n    state.fresh = true;\n    render();\n  }\n\n  // [REQ-001] equals shows the result of stored op entry\n  function equals() {\n    if (state.op === null) return;\n    var result = compute(state.stored, state.op, Number(state.entry));\n    state.entry = String(result);\n    state.stored = null;\n    state.op = null;\n    state.fresh = true;\n    render();\n  }\n\n  // [REQ-001] display shows the entry as typed; data-value holds String(value)\n  function render() {\n    displayEl.textContent = state.entry;\n    displayEl.setAttribute('data-value', String(Number(state.entry)));\n  }\n\n  document.querySelector('.keys').addEventListener('click', function (e) {\n    var btn = e.target.closest('button');\n    if (!btn) return;\n    var id = btn.getAttribute('data-testid');\n    if (btn.hasAttribute('data-digit')) inputDigit(btn.getAttribute('data-digit'));\n    else if (btn.hasAttribute('data-op')) inputOp(btn.getAttribute('data-op'));\n    else if (id === 'key-dot') inputDot();\n    else if (id === 'key-equals') equals();\n    else if (id === 'key-clear') clearAll();\n  });\n\n  clearAll();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false}}
