ght: 80px; margin-bottom: 16px; padding: 0 12px; border-radius: 12px;\n    background: #2b2f36; color: #fff; font-size: 40px; text-align: right;\n    line-height: 80px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;\n  }\n  .keys { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }\n  button {\n    height: 60px; border: 0; border-radius: 12px; font-size: 22px; cursor: pointer;\n    background: #3a3f47; color: #fff;\n  }\n  button:active { filter: brightness(1.25); }\n  .op { background: #f59e0b; }\n  .clear { background: #9ca3af; color: #111; }\n  .wide { grid-column: span 2; }\n</style>\n</head>\n<body>\n<div class=\"calc\">\n  <div class=\"display\" data-testid=\"calc-display\" data-value=\"0\">0</div>\n  <div class=\"keys\">\n    <button class=\"clear wide\" data-testid=\"key-clear\">AC</button>\n    <button class=\"op\" data-testid=\"key-div\" data-op=\"/\">÷</button>\n    <button class=\"op\" data-testid=\"key-mul\" data-op=\"*\">×</button>\n    <button data-testid=\"key-7\" data-digit=\"7\">7</button>\n    <button data-testid=\"key-8\" data-digit=\"8\">8</button>\n    <button data-testid=\"key-9\" data-digit=\"9\">9</button>\n    <button class=\"op\" data-testid=\"key-sub\" data-op=\"-\">−</button>\n    <button data-testid=\"key-4\" data-digit=\"4\">4</button>\n    <button data-testid=\"key-5\" data-digit=\"5\">5</button>\n    <button data-testid=\"key-6\" data-digit=\"6\">6</button>\n    <button class=\"op\" data-testid=\"key-add\" data-op=\"+\">+</button>\n    <button data-testid=\"key-1\" data-digit=\"1\">1</button>\n    <button data-testid=\"key-2\" data-digit=\"2\">2</button>\n    <button data-testid=\"key-3\" data-digit=\"3\">3</button>\n    <button class=\"op\" data-testid=\"key-equals\">=</button>\n    <button class=\"wide\" data-testid=\"key-0\" data-digit=\"0\">0</button>\n    <button data-testid=\"key-dot\">.</button>\n  </div>\n</div>\n<script>\n  var entry = \"0\";      // text of the current entry or last result\n  var stored = null;    // left operand\n  var op = null;        // pending operator\n  var fresh = true;     // next digit starts a new entry\n\n  var display = document.querySelector('[data-testid=\"calc-display\"]');\n\n  function compute(a, b, o) {\n    if (o === \"+\") return a + b;\n    if (o === \"-\") return a - b;\n    if (o === \"*\") return a * b;\n    return a / b;\n  }\n\n  function render() {\n    var value = Number(entry);\n    display.textContent = isFinite(value) ? entry : \"Error\";\n    display.setAttribute(\"data-value\", String(value));\n  }\n\n  function digit(d) {\n    if (fresh) { entry = d; fresh = false; }\n    else entry = entry === \"0\" ? d : entry + d;\n  }\n\n  function dot() {\n    if (fresh) { entry = \"0.\"; fresh = false; }\n    else if (entry.indexOf(\".\") === -1) entry += \".\";\n  }\n\n  function operator(o) {\n    if (op !== null && !fresh) entry = String(compute(stored, Number(entry), op));\n    stored = Number(entry);\n    op = o;\n    fresh = true;\n  }\n\n  function equals() {\n    if (op === null) return;\n    entry = String(compute(stored, Number(entry), op));\n    stored = null;\n    op = null;\n    fresh = true;\n  }\n\n  function clear() {\n    entry = \"0\"; stored = null; op = null; fresh = true;\n  }\n\n  document.querySelector(\".keys\").addEventListener(\"click\", function (e) {\n    var b = e.target.closest(\"button\");\n    if (!b) return;\n    var id = b.getAttribute(\"data-testid\");\n    if (b.hasAttribute(\"data-digit\")) digit(b.getAttribute(\"data-digit\"));\n    else if (b.hasAttribute(\"data-op\")) operator(b.getAttribute(\"data-op\"));\n    else if (id === \"key-dot\") dot();\n    else if (id === \"key-equals\") equals();\n    else if (id === \"key-clear\") clear();\n    render();\n  });\n\n  render();\n</script>\n</body>\n</html>\n","numLines":122,"startLine":1,"totalLines":122}}}
