}\n  body {\n    margin: 0;\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #e9ecef;\n    font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n  }\n  .calc {\n    width: 320px;\n    max-width: calc(100vw - 32px);\n    background: #1f2328;\n    border-radius: 20px;\n    padding: 20px;\n    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);\n  }\n  .display {\n    color: #fff;\n    font-size: 48px;\n    text-align: right;\n    padding: 16px 8px 20px;\n    min-height: 88px;\n    overflow: hidden;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n  }\n  .keys {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 12px;\n  }\n  button {\n    font: inherit;\n    font-size: 24px;\n    height: 64px;\n    border: none;\n    border-radius: 14px;\n    background: #3a3f45;\n    color: #fff;\n    cursor: pointer;\n  }\n  button:active { filter: brightness(1.25); }\n  button.op { background: #f59f00; }\n  button.op.active { background: #fff; color: #f59f00; }\n  button.clear { background: #868e96; }\n  button.wide { grid-column: span 2; }\n</style>\n</head>\n<body>\n<div class=\"calc\">\n  <div class=\"display\" data-testid=\"calc-display\" data-value=\"0\" data-error=\"false\">0</div>\n  <div class=\"keys\">\n    <button class=\"clear\" data-testid=\"key-clear\">AC</button>\n    <button class=\"clear\" data-testid=\"key-sign\">±</button>\n    <button class=\"clear\" data-testid=\"key-percent\">%</button>\n    <button class=\"op\" data-testid=\"key-div\" data-op=\"/\">÷</button>\n\n    <button data-testid=\"key-7\">7</button>\n    <button data-testid=\"key-8\">8</button>\n    <button data-testid=\"key-9\">9</button>\n    <button class=\"op\" data-testid=\"key-mul\" data-op=\"*\">×</button>\n\n    <button data-testid=\"key-4\">4</button>\n    <button data-testid=\"key-5\">5</button>\n    <button data-testid=\"key-6\">6</button>\n    <button class=\"op\" data-testid=\"key