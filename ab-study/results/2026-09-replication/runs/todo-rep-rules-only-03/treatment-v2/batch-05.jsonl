32rem; margin: 2rem auto; padding: 0 1rem; color: #222; }\n  h1 { font-size: 1.5rem; }\n  form { display: flex; gap: .5rem; }\n  form input { flex: 1; padding: .5rem; font-size: 1rem; }\n  form input[type=\"date\"] { flex: 0 0 auto; }\n  button { padding: .5rem .75rem; font-size: 1rem; cursor: pointer; }\n  ul { list-style: none; padding: 0; margin-top: 1rem; }\n  li { display: flex; align-items: center; gap: .5rem; padding: .5rem 0; border-bottom: 1px solid #ddd; }\n  li span { flex: 1; overflow-wrap: anywhere; }\n  li[data-completed=\"true\"] span { text-decoration: line-through; color: #888; }\n  li time { font-size: .875rem; color: #555; white-space: nowrap; }\n  li { border-left: 4px solid transparent; padding-left: .5rem; }\n  li[data-priority=\"high\"] { border-left-color: #d32f2f; }\n  li[data-priority=\"med\"] { border-left-color: #f0a500; }\n  li[data-priority=\"low\"] { border-left-color: #9e9e9e; }\n  li[data-overdue=\"true\"] { background: #fdecea; }\n  li[data-overdue=\"true\"] time { color: #b00020; font-weight: 600; }\n  .filters { display: flex; gap: .5rem; margin-top: 1rem; }\n  .filters button[aria-pressed=\"true\"] { font-weight: 600; }\n</style>\n</head>\n<body>\n<h1>Todos</h1>\n<form id=\"add-form\">\n  <input data-testid=\"todo-input\" type=\"text\" placeholder=\"What needs doing?\" autocomplete=\"off\">\n  <input data-testid=\"todo-due\" type=\"date\" aria-label=\"Due date\">\n  <select data-testid=\"todo-priority\" aria-label=\"Priority\">\n    <option value=\"low\">Low</option>\n    <option value=\"med\" selected>Med</option>\n    <option value=\"high\">High</option>\n  </select>\n  <button data-testid=\"todo-add\" type=\"submit\">Add</button>\n</form>\n<div class=\"filters\">\n  <button data-testid=\"filter-all\" type=\"button\" data-filter=\"all\" aria-pressed=\"true\">All</button>\n  <button data-testid=\"filter-active\" type=\"button\" data-filter=\"active\" aria-pressed=\"false\">Active</button>\n  <button data-testid=\"filter-completed\" type=\"button\" data-filter=\"completed\" aria-pressed=\"false\">Completed</button>\n</div>\n<ul data-testid=\"todo-list\"></ul>\n<script>\n(function () {\n  var KEY = 'todos';\n  var input = document.querySelector('[data-testid=\"todo-input\"]');\n  var dueInput = document.querySelector('[data-testid=\"todo-due\"]');\n  var priorityInput = document.querySelector('[data-testid=\"todo-priority\"]');\n  var list = document.querySelector('[data-testid=\"todo-list\"]');\n  var form = document.getElementById('add-form');\n  var filterButtons = document.querySelectorAll('[data-filter]');\n  var filter = 'all';\n\n  function load() {\n    try {\n      var data = JSON.parse(localStorage.getItem(KEY));\n      return Array.isArray(data) ? data : [];\n    } catch (e) {\n      return [];\n    }\n  }\n\n  function save() {\n    try { localStorage.setItem(KEY, JSON.stringify(todos)); } catch (e) {}\n  }\n\n  function newId() {\n    if (window.crypto && typeof crypto.randomUUID === 'function') return crypto.randomUUID();\n    return Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);\n  }\n\n  // Project rule: due dates are plain YYYY-MM-DD strings, read as LOCAL calendar dates.\n  // Never parse them through Date/UTC. Overdue = due date strictly before today's local date.\n  function validDue(value) {\n    return typeof value === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(value) ? value : null;\n  }\n\n  function pad(n) { return (n < 10 ? '0' : '') + n; }\n\n  function localToday(now) {\n    return now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());\n  }\n\n  // Zero-padded YYYY-MM-DD strings sort lexicographically in date order.\n  function isOverdue(due, today) {\n    return !!validDue(due) && due < today;\n  }\n\n  // Project rule: priority is low|med|high; anything else (including missing) is med.\n  function validPriority(value) {\n    return value === 'low' || value === 'high' ? value : 'med';\n  }\n\n  // Project rule: active todos first, completed below; insertion order within each group.\n  function visibleTodos(all, f) {\n    var active = all.filter(function (t) { return !t.completed; });\n    var done = all.filter(function (t) { return !!t.completed; });\n    if (f === 'active') return active;\n    if (f === 'completed') return done;\n    return active.concat(done);\n  }\n\n  function render() {\n    list.textContent = '';\n    renderedDay = localToday(new Date());\n    filterButtons.forEach(function (b) {\n      b.setAttribute('aria-pressed', String(b.dataset.filter === filter));\n    });\n    visibleTodos(todos, filter).forEach(function (todo) {\n      var li = document.createElement('li');\n      li.setAttribute('data-testid', 'todo-item');\n      li.setAttribute('data-completed', String(!!todo.completed));\n      li.setAttribute('data-overdue', String(isOverdue(todo.due, renderedDay)));\n      li.setAttribute('data-priority', validPriority(todo.priority));\n      li.dataset.id = todo.id;\n\n      var toggle = document.createElement('input');\n      toggle.setAttribute('data-testid', 'todo-toggle');\n      toggle.type = 'checkbox';\n      toggle.checked = !!todo.completed;\n      toggle.setAttribute('aria-label', 'Mark complete');\n      toggle.addEventListener('change', function () {\n        todo.completed = toggle.checked;\n        save();\n        render();\n      });\n\n      var text = document.createElement('span');\n      text.setAttribute('data-testid', 'todo-text');\n      text.textContent = todo.text;\n\n      var del = document.createElement('button');\n      del.setAttribute('data-testid', 'todo-delete');\n      del.type = 'button';\n      del.textContent = 'Delete';\n      del.addEventListener('click', function () {\n        todos = todos.filter(function (t) { return t.id !== todo.id; });\n        save();\n        render();\n      });\n\n      li.appendChild(toggle);\n      li.appendChild(text);\n      if (validDue(todo.due)) {\n        var due = document.createElement('time');\n        due.setAttribute('data-testid', 'todo-due-date');\n        due.dateTime = todo.due;\n        due.textContent = 'Due ' + todo.due;\n        li.appendChild(due);\n      }\n      li.appendChild(del);\n      list.appendChild(li);\n    });\n  }\n\n  var todos = load();\n  var renderedDay = '';\n\n  form.addEventListener('submit', function (e) {\n    e.preventDefault();\n    var text = input.value.trim();\n    if (!text) return;\n    todos.push({ id: newId(), text: text, completed: false, createdAt: Date.now(), due: validDue(dueInput.value), priority: validPriority(priorityInput.value) });\n    save();\n    render();\n    input.value = '';\n    dueInput.value = '';\n    priorityInput.value = 'med';\n    input.focus();\n  });\n\n  filterButtons.forEach(function (b) {\n    b.addEventListener('click', function () {\n      filter = b.dataset.filter;\n      render();\n    });\n  });\n\n  // Re-render when the local calendar day changes so overdue flags stay current.\n  setInterval(function () {\n    if (localToday(new Date()) !== renderedDay) render();\n  }, 60000);\n\n  render();\n})();\n</script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":95,"oldLines":10,"newStart":95,"newLines":23,"lines":["     return value === 'low' || value === 'high' ? value : 'med';","   }"," ","-  // Project rule: active todos first, completed below; insertion order within each group.","+  var PRIORITY_RANK = { high: 0, med: 1, low: 2 };","+","+  // Project rule: priority order high, med, low; insertion order within the same priority.","+  // Stable sort keeps insertion order for ties.","+  function byPriority(list) {","+    return list","+      .map(function (t, i) { return { t: t, i: i }; })","+      .sort(function (a, b) {","+        return (PRIORITY_RANK[validPriority(a.t.priority)] - PRIORITY_RANK[validPriority(b.t.priority)]) || (a.i - b.i);","+      })","+      .map(function (x) { return x.t; });","+  }","+","+  // Project rule: active todos first, completed below; within each group, sorted by priority.","   function visibleTodos(all, f) {","-    var active = all.filter(function (t) { return !t.completed; });","-    var done = all.filter(function (t) { return !!t.completed; });","+    var active = byPriority(all.filter(function (t) { return !t.completed; }));","+    var done = byPriority(all.filter(function (t) { return !!t.completed; }));","     if (f === 'active') return active;","     if (f === 'completed') return done;","     return active.concat(done);"]}],"userModified":false,"replaceAll":false}}
