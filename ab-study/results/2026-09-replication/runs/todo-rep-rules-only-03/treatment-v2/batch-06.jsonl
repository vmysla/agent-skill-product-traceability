m: 1px solid #ddd; }\n  li span { flex: 1; overflow-wrap: anywhere; }\n  li[data-completed=\"true\"] span { text-decoration: line-through; color: #888; }\n  li time { font-size: .875rem; color: #555; white-space: nowrap; }\n  li { border-left: 4px solid transparent; padding-left: .5rem; }\n  li[data-priority=\"high\"] { border-left-color: #d32f2f; }\n  li[data-priority=\"med\"] { border-left-color: #f0a500; }\n  li[data-priority=\"low\"] { border-left-color: #9e9e9e; }\n  li[data-overdue=\"true\"] { background: #fdecea; }\n  li[data-overdue=\"true\"] time { color: #b00020; font-weight: 600; }\n  .filters { display: flex; gap: .5rem; margin-top: 1rem; }\n  .filters button[aria-pressed=\"true\"] { font-weight: 600; }\n</style>\n</head>\n<body>\n<h1>Todos</h1>\n<form id=\"add-form\">\n  <input data-testid=\"todo-input\" type=\"text\" placeholder=\"What needs doing?\" autocomplete=\"off\">\n  <input data-testid=\"todo-due\" type=\"date\" aria-label=\"Due date\">\n  <select data-testid=\"todo-priority\" aria-label=\"Priority\">\n    <option value=\"low\">Low</option>\n    <option value=\"med\" selected>Med</option>\n    <option value=\"high\">High</option>\n  </select>\n  <button data-testid=\"todo-add\" type=\"submit\">Add</button>\n</form>\n<div class=\"filters\">\n  <button data-testid=\"filter-all\" type=\"button\" data-filter=\"all\" aria-pressed=\"true\">All</button>\n  <button data-testid=\"filter-active\" type=\"button\" data-filter=\"active\" aria-pressed=\"false\">Active</button>\n  <button data-testid=\"filter-completed\" type=\"button\" data-filter=\"completed\" aria-pressed=\"false\">Completed</button>\n</div>\n<ul data-testid=\"todo-list\"></ul>\n<script>\n(function () {\n  var KEY = 'todos';\n  var input = document.querySelector('[data-testid=\"todo-input\"]');\n  var dueInput = document.querySelector('[data-testid=\"todo-due\"]');\n  var priorityInput = document.querySelector('[data-testid=\"todo-priority\"]');\n  var list = document.querySelector('[data-testid=\"todo-list\"]');\n  var form = document.getElementById('add-form');\n  var filterButtons = document.querySelectorAll('[data-filter]');\n  var filter = 'all';\n\n  function load() {\n    try {\n      var data = JSON.parse(localStorage.getItem(KEY));\n      return Array.isArray(data) ? data : [];\n    } catch (e) {\n      return [];\n    }\n  }\n\n  function save() {\n    try { localStorage.setItem(KEY, JSON.stringify(todos)); } catch (e) {}\n  }\n\n  function newId() {\n    if (window.crypto && typeof crypto.randomUUID === 'function') return crypto.randomUUID();\n    return Date.now().toString(36) + '-' + Math.random().toString(36).slice(2, 10);\n  }\n\n  // Project rule: due dates are plain YYYY-MM-DD strings, read as LOCAL calendar dates.\n  // Never parse them through Date/UTC. Overdue = due date strictly before today's local date.\n  function validDue(value) {\n    return typeof value === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(value) ? value : null;\n  }\n\n  function pad(n) { return (n < 10 ? '0' : '') + n; }\n\n  function localToday(now) {\n    return now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());\n  }\n\n  // Zero-padded YYYY-MM-DD strings sort lexicographically in date order.\n  function isOverdue(due, today) {\n    return !!validDue(due) && due < today;\n  }\n\n  // Project rule: priority is low|med|high; anything else (including missing) is med.\n  function validPriority(value) {\n    return value === 'low' || value === 'high' ? value : 'med';\n  }\n\n  var PRIORITY_RANK = { high: 0, med: 1, low: 2 };\n\n  // Project rule: priority order high, med, low; insertion order within the same priority.\n  // Stable sort keeps insertion order for ties.\n  function byPriority(list) {\n    return list\n      .map(function (t, i) { return { t: t, i: i }; })\n      .sort(function (a, b) {\n        return (PRIORITY_RANK[validPriority(a.t.priority)] - PRIORITY_RANK[validPriority(b.t.priority)]) || (a.i - b.i);\n      })\n      .map(function (x) { return x.t; });\n  }\n\n  // Project rule: active todos first, completed below; within each group, sorted by priority.\n  function visibleTodos(all, f) {\n    var active = byPriority(all.filter(function (t) { return !t.completed; }));\n    var done = byPriority(all.filter(function (t) { return !!t.completed; }));\n    if (f === 'active') return active;\n    if (f === 'completed') return done;\n    return active.concat(done);\n  }\n\n  function render() {\n    list.textContent = '';\n    renderedDay = localToday(new Date());\n    filterButtons.forEach(function (b) {\n      b.setAttribute('aria-pressed', String(b.dataset.filter === filter));\n    });\n    visibleTodos(todos, filter).forEach(function (todo) {\n      var li = document.createElement('li');\n      li.setAttribute('data-testid', 'todo-item');\n      li.setAttribute('data-completed', String(!!todo.completed));\n      li.setAttribute('data-overdue', String(isOverdue(todo.due, renderedDay)));\n      li.setAttribute('data-priority', validPriority(todo.priority));\n      li.dataset.id = todo.id;\n\n      var toggle = document.createElement('input');\n      toggle.setAttribute('data-testid', 'todo-toggle');\n      toggle.type = 'checkbox';\n      toggle.checked = !!todo.completed;\n      toggle.setAttribute('aria-label', 'Mark complete');\n      toggle.addEventListener('change', function () {\n        todo.completed = toggle.checked;\n        save();\n        render();\n      });\n\n      var text = document.createElement('span');\n      text.setAttribute('data-testid', 'todo-text');\n      text.textContent = todo.text;\n\n      var del = document.createElement('button');\n      del.setAttribute('data-testid', 'todo-delete');\n      del.type = 'button';\n      del.textContent = 'Delete';\n      del.addEventListener('click', function () {\n        todos = todos.filter(function (t) { return t.id !== todo.id; });\n        save();\n        render();\n      });\n\n      li.appendChild(toggle);\n     